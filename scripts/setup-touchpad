#!/usr/bin/env bash
set -euo pipefail

# Qtile-Con Touchpad Configuration
# Enables single-tap (left click), double-tap (double click),
# two-finger tap (right click), three-finger tap (middle click),
# tap-and-drag, and natural scrolling across all detected touchpads.

export DISPLAY="${DISPLAY:-:0}"

if ! command -v xinput >/dev/null 2>&1; then
  exit 0
fi

touchpad_found=0

while read -r id; do
  [[ -z "$id" ]] && continue
  props="$(xinput list-props "$id" 2>/dev/null || true)"
  if [[ "$props" == *"libinput Tapping Enabled ("* ]]; then
    touchpad_found=1
    xinput set-prop "$id" "libinput Tapping Enabled" 1 2>/dev/null || true
    xinput set-prop "$id" "libinput Tapping Drag Enabled" 1 2>/dev/null || true
    xinput set-prop "$id" "libinput Natural Scrolling Enabled" 1 2>/dev/null || true
    # Enable Clickfinger (1 finger = left, 2 fingers = right, 3 fingers = middle)
    if [[ "$props" == *"libinput Click Method Enabled ("* ]]; then
      xinput set-prop "$id" "libinput Click Method Enabled" 0 1 2>/dev/null || true
    fi
    if [[ "${1:-}" == "--verbose" || "${1:-}" == "-v" ]]; then
      dev_name="$(xinput list --name-only "$id" 2>/dev/null || echo "Device $id")"
      echo "[OK] Configured tap-to-click on touchpad: $dev_name (id: $id)"
    fi
  fi
done < <(xinput list --id-only 2>/dev/null | grep -E '^[0-9]+$' || true)

if [[ "${1:-}" == "--verbose" || "${1:-}" == "-v" ]]; then
  if [[ "$touchpad_found" -eq 0 ]]; then
    echo "[INFO] No libinput touchpad device detected."
  fi
fi

exit 0

#!/usr/bin/env bash
set -euo pipefail
action="${1:-launcher}"
case "$action" in
  launcher) exec fuzzel ;;
  clipboard)
    if command -v cliphist >/dev/null 2>&1; then
      cliphist list | fuzzel --dmenu --prompt='Clipboard > ' | cliphist decode | wl-copy
    else
      notify-send "Clipboard" "Install cliphist and enable its watcher"
    fi
    ;;
  layout)
    # Show the current screen's layout names, then select one interactively.
    layouts="$(qtile cmd-obj -o cmd -f eval -a '",".join([l.name for l in qtile.current_group.layouts])' 2>/dev/null || true)"
    choice="$(printf '%s\n' "${layouts//,/\n}" | fuzzel --dmenu --prompt='Layout > ' || true)"
    [[ -n "$choice" ]] && qtile cmd-obj -o cmd -f next_layout
    ;;
  *) echo "Usage: qtile-action [launcher|clipboard|layout]" >&2; exit 2 ;;
esac

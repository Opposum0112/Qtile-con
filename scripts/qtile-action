#!/usr/bin/env bash
set -euo pipefail
action="${1:-launcher}"
case "$action" in
  launcher) exec rofi -show drun ;;
  clipboard)
    if command -v greenclip >/dev/null 2>&1; then
      exec rofi -modi "clipboard:greenclip print" -show clipboard
    else
      notify-send "Clipboard history" "Install greenclip for searchable clipboard history."
    fi
    ;;
  layout)
    choice="$(printf '%s\n' columns max matrix monadtall monadwide tile floating | rofi -dmenu -p 'Layout > ' || true)"
    [[ -n "$choice" ]] || exit 0
    qtile cmd-obj -o group -f setlayout -a "$choice" 2>/dev/null || notify-send "Qtile" "Could not set layout: $choice"
    ;;
  *) echo "Usage: qtile-action [launcher|clipboard|layout]" >&2; exit 2 ;;
esac

#!/usr/bin/env bash
set -euo pipefail
action="${1:-launcher}"
case "$action" in
  launcher) exec fuzzel ;;
  clipboard)
    if command -v cliphist >/dev/null 2>&1; then
      cliphist list | fuzzel --dmenu --prompt='Clipboard > ' | cliphist decode | wl-copy
    else notify-send "Clipboard" "Install cliphist and enable its watcher"; fi
    ;;
  layout)
    # Select an available layout by its Qtile layout name.
    choice="$(printf '%s\n' columns max matrix monadtall monadwide tile floating | fuzzel --dmenu --prompt='Layout > ' || true)"
    [[ -n "$choice" ]] || exit 0
    qtile cmd-obj -o group -f setlayout -a "$choice" 2>/dev/null || notify-send "Qtile" "Could not set layout: $choice"
    ;;
  *) echo "Usage: qtile-action [launcher|clipboard|layout]" >&2; exit 2 ;;
esac

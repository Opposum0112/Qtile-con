def apply_rofi(palette, theme_name):
    """Regenerate active Rofi themes across ~/.config/qtile/themes and repo."""
    rofi_content = generate_rofi_theme(palette, theme_name)
    grid_content = generate_rofi_grid_theme(palette, theme_name)
    weather_content = generate_rofi_weather_theme(palette, theme_name)

    repo_dir = Path(__file__).resolve().parent.parent / "themes"
    cfg_dir = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "qtile/themes"
    cfg_dir.mkdir(parents=True, exist_ok=True)

    dirs = [d for d in [repo_dir, cfg_dir] if d.exists()]
    for d in dirs:
        # Standard default theme
        (d / "catppuccin-mocha.rasi").write_text(rofi_content, encoding="utf-8")
        (d / "active-theme.rasi").write_text(rofi_content, encoding="utf-8")
        # Grid theme (wallpaper / font selection)
        (d / "catppuccin-mocha-grid.rasi").write_text(grid_content, encoding="utf-8")
        (d / "active-grid.rasi").write_text(grid_content, encoding="utf-8")
        # Weather theme
        (d / "catppuccin-mocha-weather.rasi").write_text(weather_content, encoding="utf-8")
        (d / "active-weather.rasi").write_text(weather_content, encoding="utf-8")
        # State record
        (d / "current_theme.json").write_text(json.dumps({
            "name": theme_name,
            "colors": palette,
            "palette": palette
        }, indent=2), encoding="utf-8")


def apply_dunst(palette):
    """Regenerate Dunst notification colors in ~/.config/dunst/dunstrc."""
    dunst_dir = Path.home() / ".config" / "dunst"
    dunst_dir.mkdir(parents=True, exist_ok=True)
    dunstrc_path = dunst_dir / "dunstrc"

    base = palette.get("base", "#1e1e2e")
    text = palette.get("text", "#cdd6f4")
    mauve = palette.get("mauve", "#cba6f7")
    overlay = palette.get("overlay", "#6c7086")
    red = palette.get("red", "#f38ba8")

    dunst_content = f"""[global]
    monitor = 0
    follow = keyboard
    width = 380
    height = 300
    origin = top-right
    offset = 16x48
    scale = 0
    notification_limit = 5
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 6
    icon_corner_radius = 6
    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 12
    frame_width = 2
    frame_color = "{mauve}"
    gap_size = 6
    separator_color = frame
    sort = yes
    font = JetBrainsMono Nerd Font 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    enable_recursive_icon_lookup = true
    icon_theme = "Adwaita, Papirus, Papirus-Dark, hicolor"
    icon_position = left
    min_icon_size = 24
    max_icon_size = 48
    sticky_history = yes
    history_length = 20
    dmenu = /usr/bin/rofi -dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 12
    timeout = 6

[urgency_low]
    background = "{base}"
    foreground = "{text}"
    frame_color = "{overlay}"
    timeout = 4

[urgency_normal]
    background = "{base}"
    foreground = "{text}"
    frame_color = "{mauve}"
    timeout = 6

[urgency_critical]
    background = "{base}"
    foreground = "{red}"
    frame_color = "{red}"
    timeout = 0
"""
    try:
        if dunstrc_path.is_symlink() and not dunstrc_path.exists():
            dunstrc_path.unlink()
        dunstrc_path.write_text(dunst_content, encoding="utf-8")
        subprocess.run(["dunstctl", "reload"], stderr=subprocess.DEVNULL)
        subprocess.run(["killall", "-SIGUSR2", "dunst"], stderr=subprocess.DEVNULL)
    except Exception:
        pass


def apply_thunar_and_gtk(palette, theme_name):
    """Synchronize Thunar and GTK icon/widget theme with the selected global theme."""
    light = is_light_theme(palette, theme_name)
    tl = theme_name.lower()

    if light:
        icon_variant = "Tela-light" if (Path.home() / ".local/share/icons/Tela-light").is_dir() else "Tela"
        gtk_variant = "ARK-Light" if os.path.isdir("/usr/share/themes/ARK-Light") else "Adwaita"
    else:
        if "dracula" in tl and (Path.home() / ".local/share/icons/Tela-dracula-dark").is_dir():
            icon_variant = "Tela-dracula-dark"
        elif "nord" in tl and (Path.home() / ".local/share/icons/Tela-nord-dark").is_dir():
            icon_variant = "Tela-nord-dark"
        else:
            icon_variant = "Tela-dark" if (Path.home() / ".local/share/icons/Tela-dark").is_dir() else "Tela"
        gtk_variant = "ARK-Dark" if os.path.isdir("/usr/share/themes/ARK-Dark") else "Adwaita-dark"

    base = palette.get("base", "#1e1e2e")
    mantle = palette.get("mantle", "#181825")
    surface0 = palette.get("surface0", "#313244")
    surface1 = palette.get("surface1", "#45475a")
    surface2 = palette.get("surface2", "#585b70")
    text = palette.get("text", "#cdd6f4")
    subtext = palette.get("subtext", "#a6adc8")
    mauve = palette.get("mauve", "#cba6f7")
    blue = palette.get("blue", "#89b4fa")
    red = palette.get("red", "#f38ba8")
    green = palette.get("green", "#a6e3a1")
    yellow = palette.get("yellow", "#f9e2af")
    sel_fg = base if light else "#ffffff"

    # 1. Update gsettings if available
    if shutil.which("gsettings"):
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", icon_variant], stderr=subprocess.DEVNULL)
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", gtk_variant], stderr=subprocess.DEVNULL)
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "color-scheme", "prefer-light" if light else "prefer-dark"], stderr=subprocess.DEVNULL)

    # 2. Update xfconf-query (XFCE / Thunar xsettings) if available
    if shutil.which("xfconf-query"):
        subprocess.run(["xfconf-query", "-c", "xsettings", "-p", "/Net/IconThemeName", "-s", icon_variant], stderr=subprocess.DEVNULL)
        subprocess.run(["xfconf-query", "-c", "xsettings", "-p", "/Net/ThemeName", "-s", gtk_variant], stderr=subprocess.DEVNULL)

    # 3. Dynamic GTK colors.css
    gtk_colors = f"""/* GTK 3 / Thunar dynamic theme colors synchronized by Qtile-Con */
@define-color theme_bg_color {base};
@define-color theme_fg_color {text};
@define-color theme_base_color {base};
@define-color theme_text_color {text};
@define-color theme_selected_bg_color {mauve};
@define-color theme_selected_fg_color {sel_fg};
@define-color borders {surface1};
@define-color headerbar_bg_color {surface0};
@define-color headerbar_fg_color {text};
@define-color sidebar_bg_color {mantle};
@define-color sidebar_fg_color {text};
@define-color content_view_bg {base};
@define-color error_color {red};
@define-color success_color {green};
@define-color warning_color {yellow};
@define-color insensitive_bg_color {surface0};
@define-color insensitive_fg_color {surface2};
@define-color insensitive_base_color {base};
"""

    # 4. Dynamic GTK gtk.css with explicit Thunar styling
    gtk_css = f"""/* GTK 3 and Thunar File Manager custom styling */
@import 'colors.css';

window, dialog {{
    background-color: @theme_bg_color;
    color: @theme_fg_color;
}}

/* Thunar file manager window, sidebar, view, and pathbar */
window.thunar,
.thunar window {{
    background-color: @theme_bg_color;
    color: @theme_fg_color;
}}

.thunar .sidebar,
.thunar .sidebar .view,
.thunar .sidebar scrolledwindow,
.thunar .sidebar treeview {{
    background-color: @sidebar_bg_color;
    color: @sidebar_fg_color;
}}

.thunar .standard-view .view,
.thunar .view {{
    background-color: @theme_base_color;
    color: @theme_text_color;
}}

.thunar .view:selected,
.thunar .view:selected:focus {{
    background-color: @theme_selected_bg_color;
    color: @theme_selected_fg_color;
}}

.thunar path-bar button {{
    background-color: @headerbar_bg_color;
    color: @theme_fg_color;
    border: 1px solid @borders;
    border-radius: 4px;
    padding: 3px 8px;
}}

.thunar path-bar button:checked,
.thunar path-bar button:active {{
    background-color: @theme_selected_bg_color;
    color: @theme_selected_fg_color;
}}

.thunar toolbar,
.thunar menubar {{
    background-color: @headerbar_bg_color;
    color: @headerbar_fg_color;
    border-bottom: 1px solid @borders;
}}

.thunar statusbar {{
    background-color: @headerbar_bg_color;
    color: @headerbar_fg_color;
    border-top: 1px solid @borders;
}}
"""

    # Write GTK 3 files
    gtk3_dir = Path.home() / ".config/gtk-3.0"
    gtk3_dir.mkdir(parents=True, exist_ok=True)
    try:
        (gtk3_dir / "colors.css").write_text(gtk_colors, encoding="utf-8")
        (gtk3_dir / "gtk.css").write_text(gtk_css, encoding="utf-8")
        (gtk3_dir / "settings.ini").write_text(f"""[Settings]
gtk-theme-name={gtk_variant}
gtk-icon-theme-name={icon_variant}
gtk-application-prefer-dark-theme={0 if light else 1}
gtk-font-name=Cantarell 11
gtk-cursor-theme-name=Adwaita
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle=hintfull
""", encoding="utf-8")
    except OSError:
        pass

    # Write GTK 4 files if directory exists or create
    gtk4_dir = Path.home() / ".config/gtk-4.0"
    gtk4_dir.mkdir(parents=True, exist_ok=True)
    try:
        (gtk4_dir / "colors.css").write_text(gtk_colors, encoding="utf-8")
        (gtk4_dir / "gtk.css").write_text(gtk_css, encoding="utf-8")
        (gtk4_dir / "settings.ini").write_text(f"""[Settings]
gtk-theme-name={gtk_variant}
gtk-icon-theme-name={icon_variant}
gtk-application-prefer-dark-theme={0 if light else 1}
gtk-font-name=Cantarell 11
gtk-cursor-theme-name=Adwaita
""", encoding="utf-8")
    except OSError:
        pass

    # Update ~/.gtkrc-2.0
    gtk2_file = Path.home() / ".gtkrc-2.0"
    try:
        gtk2_file.write_text(f"""gtk-theme-name="{gtk_variant}"
gtk-icon-theme-name="{icon_variant}"
gtk-font-name="Cantarell 11"
""", encoding="utf-8")
    except OSError:
        pass

    # Update xsettingsd configurations
    xsettings_content = f"""Net/ThemeName "{gtk_variant}"
Net/IconThemeName "{icon_variant}"
Gtk/CursorThemeName "Adwaita"
Gtk/FontName "Cantarell 11"
Gtk/DecorationLayout "close,maximize,minimize:"
"""
    for xsf in [Path.home() / ".config/xsettingsd/xsettingsd.conf", Path.home() / ".xsettingsd"]:
        try:
            xsf.parent.mkdir(parents=True, exist_ok=True)
            xsf.write_text(xsettings_content, encoding="utf-8")
        except OSError:
            pass

    # Notify or start xsettingsd
    subprocess.run(["pkill", "-HUP", "-x", "xsettingsd"], stderr=subprocess.DEVNULL)

    # Terminate running Thunar background daemon so next launch loads fresh theme and CSS
    subprocess.run(["thunar", "-q"], stderr=subprocess.DEVNULL)
    subprocess.run(["pkill", "-f", "thunar"], stderr=subprocess.DEVNULL)


def apply_yazi(palette, theme_name):
    """Synchronize Yazi file manager theme flavor with the selected global theme."""
    yazi_dir = Path.home() / ".config" / "yazi"
    yazi_dir.mkdir(parents=True, exist_ok=True)
    theme_file = yazi_dir / "theme.toml"

    tl = theme_name.lower()
    flavor = "catppuccin-mocha"
    if "latte" in tl:
        flavor = "catppuccin-latte"
    elif "frappe" in tl:
        flavor = "catppuccin-frappe"
    elif "macchiato" in tl:
        flavor = "catppuccin-macchiato"
    elif "dracula" in tl:
        flavor = "dracula"
    elif "gruvbox" in tl:
        flavor = "gruvbox-dark"

    theme_content = f"""# Dynamically generated by Qtile-Con global theme switcher
[flavor]
use = "{flavor}"
"""
    try:
        theme_file.write_text(theme_content, encoding="utf-8")
    except OSError:
        pass


def apply_helix(palette, theme_name):
    """Synchronize Helix modal editor theme with the selected global theme."""
    helix_dir = Path.home() / ".config" / "helix"
    helix_dir.mkdir(parents=True, exist_ok=True)
    config_file = helix_dir / "config.toml"

    tl = theme_name.lower()
    helix_theme = "catppuccin_mocha"
    if "latte" in tl:
        helix_theme = "catppuccin_latte"
    elif "frappe" in tl:
        helix_theme = "catppuccin_frappe"
    elif "macchiato" in tl:
        helix_theme = "catppuccin_macchiato"
    elif "gruvbox" in tl:
        helix_theme = "gruvbox"
    elif "github" in tl:
        helix_theme = "github_dark"
    elif "solarized" in tl:
        helix_theme = "solarized_dark"
    elif "ayu" in tl:
        helix_theme = "ayu_dark"

    if config_file.is_file():
        try:
            content = config_file.read_text(encoding="utf-8")
            import re
            new_content = re.sub(r'theme\s*=\s*"[^"]*"', f'theme = "{helix_theme}"', content, count=1)
            config_file.write_text(new_content, encoding="utf-8")
        except OSError:
            pass
    else:
        try:
            config_file.write_text(f'theme = "{helix_theme}"\n', encoding="utf-8")
        except OSError:
            pass


def apply_fastfetch(palette, theme_name):
    """Synchronize fastfetch logo, keys, and theme display with the active palette."""
    def hex_to_rgb(hex_str):
        h = hex_str.lstrip('#')
        if len(h) == 3:
            h = ''.join([c*2 for c in h])
        return tuple(int(h[i:i+2], 16) for i in (0, 2, 4))

    c_mauve = palette.get("mauve", "#cba6f7")
    c_lavender = palette.get("lavender", "#b4befe")
    c_blue = palette.get("blue", "#89b4fa")
    c_sky = palette.get("sky", "#74c7ec")
    c_teal = palette.get("teal", "#94e2d5")
    c_green = palette.get("green", "#a6e3a1")
    c_yellow = palette.get("yellow", "#f9e2af")
    c_peach = palette.get("peach", "#fab387")
    c_red = palette.get("red", "#f38ba8")
    c_surface1 = palette.get("surface1", "#45475a")
    c_overlay0 = palette.get("overlay0", palette.get("overlay", "#6c7086"))

    r_mauve, g_mauve, b_mauve = hex_to_rgb(c_mauve)
    r_lav, g_lav, b_lav = hex_to_rgb(c_lavender)
    r_blue, g_blue, b_blue = hex_to_rgb(c_blue)
    r_sky, g_sky, b_sky = hex_to_rgb(c_sky)
    r_teal, g_teal, b_teal = hex_to_rgb(c_teal)
    r_green, g_green, b_green = hex_to_rgb(c_green)
    r_yel, g_yel, b_yel = hex_to_rgb(c_yellow)
    r_peach, g_peach, b_peach = hex_to_rgb(c_peach)
    r_red, g_red, b_red = hex_to_rgb(c_red)
    r_s1, g_s1, b_s1 = hex_to_rgb(c_surface1)
    r_ov, g_ov, b_ov = hex_to_rgb(c_overlay0)

    titles = {
        "catppuccin-mocha": "Catppuccin Mocha",
        "catppuccin-latte": "Catppuccin Latte",
        "catppuccin-frappe": "Catppuccin Frappé",
        "catppuccin-macchiato": "Catppuccin Macchiato",
        "nord": "Nord Arctic",
        "dracula": "Dracula",
        "gruvbox-dark": "Gruvbox Dark",
        "gruvbox": "Gruvbox Dark",
        "tokyo-night": "Tokyo Night",
        "rose-pine": "Rosé Pine",
        "solarized-dark": "Solarized Dark",
        "ayu-dark": "Ayu Dark",
        "github-dark": "GitHub Dark",
        "kanagawa": "Kanagawa",
        "everforest-dark": "Everforest Dark",
        "cyberpunk": "Cyberpunk Neon",
        "synthwave": "Synthwave '84",
        "monokai-pro": "Monokai Pro",
        "one-dark": "One Dark Pro",
    }
    title = titles.get(theme_name, theme_name.replace("-", " ").title())

    logo_source = (
        f"  \u001b[38;2;{r_mauve};{g_mauve};{b_mauve}m▄██████▄\u001b[0m  \n"
        f" \u001b[38;2;{r_mauve};{g_mauve};{b_mauve}m██▀    ▀██\u001b[0m \n"
        f" \u001b[38;2;{r_lav};{g_lav};{b_lav}m██      ██\u001b[0m \n"
        f" \u001b[38;2;{r_blue};{g_blue};{b_blue}m██      ██\u001b[0m \n"
        f" \u001b[38;2;{r_sky};{g_sky};{b_sky}m██▄    ▄██\u001b[0m \n"
        f"  \u001b[38;2;{r_teal};{g_teal};{b_teal}m▀██████▀\u001b[0m  \n"
        f"        \u001b[38;2;{r_red};{g_red};{b_red}m▀██\u001b[0m \n"
        f"    \u001b[1;38;2;{r_mauve};{g_mauve};{b_mauve}mQTILE\u001b[0m   "
    )

    fastfetch_config = {

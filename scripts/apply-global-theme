#!/usr/bin/env python3
"""Unified global theme synchronizer for Qtile, Alacritty, Kitty, Micro, Firefox, and Rofi."""
import glob
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path


def load_theme(json_path):
    with open(json_path, "r", encoding="utf-8") as f:
        return json.load(f)


def apply_qtile(palette, theme_name):
    # Update qtile_config/colors.py in repo and ~/.config/qtile
    base = palette.get("base", "#1e1e2e")
    text = palette.get("text", "#cdd6f4")
    mauve = palette.get("mauve", "#cba6f7")
    overlay = palette.get("overlay", "#6c7086")

    content = f'''"""Theme colors loaded from preset ({theme_name})."""
COLORS = {json.dumps(palette, indent=4)}

BG = COLORS.get("base", "{base}")
FG = COLORS.get("text", "{text}")
ACCENT = COLORS.get("mauve", "{mauve}")
MUTED = COLORS.get("overlay", "{overlay}")
'''
    targets = [
        Path(__file__).resolve().parent.parent / "qtile_config" / "colors.py",
        Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "qtile" / "qtile_config" / "colors.py",
    ]
    for target in targets:
        if target.parent.exists():
            target.write_text(content, encoding="utf-8")


def apply_alacritty(palette):
    alacritty_dir = Path.home() / ".config" / "alacritty"
    alacritty_dir.mkdir(parents=True, exist_ok=True)
    theme_file = alacritty_dir / "qtile-con-catppuccin-mocha.toml"

    base = palette.get("base", "#1e1e2e")
    text = palette.get("text", "#cdd6f4")
    surface0 = palette.get("surface0", "#313244")
    surface1 = palette.get("surface1", "#45475a")
    surface2 = palette.get("surface2", "#585b70")
    subtext = palette.get("subtext", "#a6adc8")
    red = palette.get("red", "#f38ba8")
    green = palette.get("green", "#a6e3a1")
    yellow = palette.get("yellow", "#f9e2af")
    blue = palette.get("blue", "#89b4fa")
    mauve = palette.get("mauve", "#cba6f7")
    teal = palette.get("teal", "#94e2d5")
    pink = palette.get("pink", "#f5c2e7")

    toml_content = f"""# Dynamically generated palette by Qtile-Con
[colors.primary]
background = "{base}"
foreground = "{text}"

[colors.cursor]
text = "{base}"
cursor = "{text}"

[colors.normal]
black   = "{surface1}"
red     = "{red}"
green   = "{green}"
yellow  = "{yellow}"
blue    = "{blue}"
magenta = "{mauve}"
cyan    = "{teal}"
white   = "{subtext}"

[colors.bright]
black   = "{surface2}"
red     = "{red}"
green   = "{green}"
yellow  = "{yellow}"
blue    = "{blue}"
magenta = "{pink}"
cyan    = "{teal}"
white   = "{text}"
"""
    theme_file.write_text(toml_content, encoding="utf-8")


def apply_kitty(palette):
    kitty_dir = Path.home() / ".config" / "kitty"
    kitty_dir.mkdir(parents=True, exist_ok=True)

    base = palette.get("base", "#1e1e2e")
    mantle = palette.get("mantle", "#181825")
    crust = palette.get("crust", "#11111b")
    text = palette.get("text", "#cdd6f4")
    subtext = palette.get("subtext", "#a6adc8")
    surface0 = palette.get("surface0", "#313244")
    surface1 = palette.get("surface1", "#45475a")
    surface2 = palette.get("surface2", "#585b70")
    overlay = palette.get("overlay", "#6c7086")
    lavender = palette.get("lavender", "#b4befe")
    mauve = palette.get("mauve", "#cba6f7")
    pink = palette.get("pink", "#f5c2e7")
    red = palette.get("red", "#f38ba8")
    yellow = palette.get("yellow", "#f9e2af")
    green = palette.get("green", "#a6e3a1")
    teal = palette.get("teal", "#94e2d5")
    blue = palette.get("blue", "#89b4fa")
    rosewater = palette.get("rosewater", "#f5e0dc")

    conf_content = f"""# Dynamic theme generated by Qtile-Con
foreground              {text}
background              {base}
selection_foreground    {base}
selection_background    {rosewater}

cursor                  {rosewater}
cursor_text_color       {base}

url_color               {rosewater}

active_border_color     {lavender}
inactive_border_color   {overlay}
bell_border_color       {yellow}

active_tab_foreground   {crust}
active_tab_background   {mauve}
inactive_tab_foreground {text}
inactive_tab_background {mantle}
tab_bar_background      {crust}

# 16 terminal colors
# black
color0 {surface1}
color8 {surface2}

# red
color1 {red}
color9 {red}

# green
color2 {green}
color10 {green}

# yellow
color3 {yellow}
color11 {yellow}

# blue
color4 {blue}
color12 {blue}

# magenta
color5 {mauve}
color13 {pink}

# cyan
color6 {teal}
color14 {teal}

# white
color7 {subtext}
color15 {text}
"""
    targets = [
        kitty_dir / "qtile-theme.conf",
        kitty_dir / "current-theme.conf",
        kitty_dir / "dark-theme.auto.conf",
    ]
    for t in targets:
        try:
            t.write_text(conf_content, encoding="utf-8")
        except OSError:
            pass

    # Send SIGUSR1 to running kitty instances to reload theme live
    subprocess.run(["pkill", "-SIGUSR1", "-u", str(os.getuid()), "kitty"], stderr=subprocess.DEVNULL)


def is_light_theme(palette, theme_name=""):
    """Determine whether palette represents a light or dark theme."""
    if "latte" in theme_name.lower() or "light" in theme_name.lower():
        return True
    base = palette.get("base", "#1e1e2e").lstrip("#")
    if len(base) == 6:
        try:
            r, g, b = int(base[0:2], 16), int(base[2:4], 16), int(base[4:6], 16)
            return (0.299 * r + 0.587 * g + 0.114 * b) > 140
        except ValueError:
            pass
    return False


def apply_micro(palette, theme_name="qtile-theme"):
    """Synchronize Micro editor colorscheme and settings with the selected global theme."""
    micro_dir = Path.home() / ".config" / "micro"
    cs_dir = micro_dir / "colorschemes"
    cs_dir.mkdir(parents=True, exist_ok=True)
    cs_file = cs_dir / "qtile-theme.micro"

    base = palette.get("base", "#1e1e2e")
    text = palette.get("text", "#cdd6f4")
    surface0 = palette.get("surface0", "#313244")
    surface1 = palette.get("surface1", "#45475a")
    surface2 = palette.get("surface2", "#585b70")
    overlay = palette.get("overlay", "#6c7086")
    lavender = palette.get("lavender", "#b4befe")
    red = palette.get("red", "#f38ba8")
    green = palette.get("green", "#a6e3a1")
    yellow = palette.get("yellow", "#f9e2af")
    blue = palette.get("blue", "#89b4fa")
    mauve = palette.get("mauve", "#cba6f7")
    teal = palette.get("teal", "#94e2d5")
    pink = palette.get("pink", "#f5c2e7")
    peach = palette.get("peach", "#fab387")
    rosewater = palette.get("rosewater", text)

    # Micro colorscheme format: color-link <group> "<foreground>[,<background>]"
    # Note: For cursor-line, micro accepts single background color or background,foreground.
    micro_css = f"""color-link default "{text},{base}"
color-link comment "{overlay}"
color-link selection "{text},{surface1}"
color-link hlsearch "{text},{teal}"
color-link identifier "{blue}"
color-link identifier.class "{blue}"
color-link identifier.var "{blue}"
color-link constant "{peach}"
color-link constant.number "{peach}"
color-link constant.string "{green}"
color-link constant.bool "{peach}"
color-link symbol "{pink}"
color-link symbol.brackets "{rosewater}"
color-link symbol.operator "{mauve}"
color-link symbol.tag "{blue}"
color-link type "{blue}"
color-link type.keyword "{mauve}"
color-link statement "{mauve}"
color-link special "{pink}"
color-link preproc "{pink}"
color-link underlined "underline {teal}"
color-link error "bold {red}"
color-link error-message "{red}"
color-link todo "bold {yellow}"
color-link statusline "{text},{surface0}"
color-link tabbar "{text},{surface0}"
color-link indent-char "{surface1}"
color-link line-number "{surface1}"
color-link current-line-number "{lavender}"
color-link cursor-line "{surface0}"
color-link color-column "{surface0}"
color-link divider "{surface1}"
color-link scrollbar "{surface1}"
color-link message "{text}"
color-link diff-added "{green}"
color-link diff-modified "{yellow}"
color-link diff-deleted "{red}"
color-link gutter-error "{red}"
color-link gutter-warning "{yellow}"
color-link type.extended "default"
"""
    # 1. Update ~/.config/micro/colorschemes/qtile-theme.micro
    cs_file.write_text(micro_css, encoding="utf-8")

    # 2. Also write named colorscheme (e.g. catppuccin-mocha.micro)
    if theme_name and theme_name != "qtile-theme":
        safe_name = theme_name.lower().replace(" ", "-")
        named_cs_file = cs_dir / f"{safe_name}.micro"
        try:
            named_cs_file.write_text(micro_css, encoding="utf-8")
        except OSError:
            pass

    # 3. Update repo copy if repo micro directory exists
    repo_micro = Path(__file__).resolve().parent.parent / "micro"
    try:
        repo_micro.mkdir(parents=True, exist_ok=True)
        (repo_micro / "qtile-theme.micro").write_text(micro_css, encoding="utf-8")
    except OSError:
        pass

    # 4. Update micro settings.json
    settings_file = micro_dir / "settings.json"
    settings = {}
    if settings_file.is_file():
        try:
            settings = json.loads(settings_file.read_text(encoding="utf-8"))
        except Exception:
            settings = {}
    settings["colorscheme"] = "qtile-theme"
    try:
        settings_file.write_text(json.dumps(settings, indent=4), encoding="utf-8")
    except OSError:
        pass


def apply_firefox(palette, theme_name="qtile-theme", restart_if_running=True):
    """Synchronize Firefox browser styling (userChrome.css, userContent.css, user.js) with the global theme."""
    mozilla_dir = Path.home() / ".mozilla" / "firefox"
    if not mozilla_dir.exists():
        return

    light = is_light_theme(palette, theme_name)
    color_scheme = "light" if light else "dark"
    theme_code = 1 if light else 0
    dark_flag = 0 if light else 1

    base = palette.get("base", "#1e1e2e")
    surface0 = palette.get("surface0", "#313244")
    surface1 = palette.get("surface1", "#45475a")
    surface2 = palette.get("surface2", "#585b70")
    text = palette.get("text", "#cdd6f4")
    mauve = palette.get("mauve", "#cba6f7")
    rosewater = palette.get("rosewater", text)
    red = palette.get("red", "#f38ba8")

    active_theme_id = "firefox-compact-light@mozilla.org" if light else "firefox-compact-dark@mozilla.org"
    dark_flag_bool = "false" if light else "true"

    # Explicit user.js preferences to enforce matching theme and stylesheet execution
    managed_keys = [
        "toolkit.legacyUserProfileCustomizations.stylesheets",
        "svg.context-properties.content.enabled",
        "layout.css.color-mix.enabled",
        "browser.startup.page",
        "nglayout.debug.disable_chrome_cache",
        "ui.systemUsesDarkTheme",
        "browser.theme.toolbar-theme",
        "browser.theme.content-theme",
        "layout.css.prefers-color-scheme.content-override",
        "extensions.activeThemeID",
        "widget.chrome.allow-gtk-dark-theme",
    ]

    managed_prefs = [
        '// Qtile-Con dynamic global theme configuration',
        'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);',
        'user_pref("svg.context-properties.content.enabled", true);',
        'user_pref("layout.css.color-mix.enabled", true);',
        'user_pref("browser.startup.page", 3);',
        'user_pref("nglayout.debug.disable_chrome_cache", true);',
        f'user_pref("ui.systemUsesDarkTheme", {dark_flag});',
        f'user_pref("browser.theme.toolbar-theme", {theme_code});',
        f'user_pref("browser.theme.content-theme", {theme_code});',
        f'user_pref("layout.css.prefers-color-scheme.content-override", {theme_code});',
        f'user_pref("extensions.activeThemeID", "{active_theme_id}");',
        f'user_pref("widget.chrome.allow-gtk-dark-theme", {dark_flag_bool});',
    ]

    user_chrome_content = f"""/* Qtile-Con dynamic global theme colors */

:root {{
    color-scheme: {color_scheme} !important;
    --toolbar-bgcolor: {base} !important;
    --toolbar-color: {text} !important;
    --toolbar-non-lwt-bgcolor: {base} !important;
    --toolbar-non-lwt-textcolor: {text} !important;
    --toolbar-field-background-color: {surface0} !important;
    --toolbar-field-color: {text} !important;
    --toolbar-field-border-color: {surface1} !important;
    --toolbar-field-focus-background-color: {surface1} !important;
    --toolbar-field-focus-color: {text} !important;
    --toolbar-field-focus-border-color: {mauve} !important;
    --urlbar-box-bgcolor: {surface0} !important;
    --urlbar-box-hover-bgcolor: {surface1} !important;
    --urlbar-box-active-bgcolor: {surface1} !important;
    --lwt-accent-color: {base} !important;
    --lwt-text-color: {text} !important;
    --lwt-toolbar-field-background-color: {surface0} !important;
    --lwt-toolbar-field-color: {text} !important;
    --lwt-toolbar-field-border-color: {surface1} !important;
    --lwt-selected-tab-background-color: {surface1} !important;
    --arrowpanel-background: {surface0} !important;
    --arrowpanel-color: {text} !important;
    --arrowpanel-border-color: {mauve} !important;
    --autocomplete-popup-background: {surface0} !important;
    --autocomplete-popup-color: {text} !important;
    --tab-selected-bgcolor: {surface1} !important;
    --tab-selected-textcolor: {rosewater} !important;
    --tab-hover-bgcolor: {surface0} !important;
    --chrome-content-separator-color: {surface1} !important;
}}

/* Navigator Toolbox, Toolbars & Titlebar */
#navigator-toolbox,
#nav-bar,
#TabsToolbar,
#PersonalToolbar,
#titlebar {{
    background-color: {base} !important;
    color: {text} !important;
    border-color: transparent !important;
}}

/* Tab Styling - Modern Proton & Firefox 115-140+ ESR */
.tab-background {{
    border-radius: 6px 6px 0 0 !important;
    margin-block: 2px !important;
}}
.tabbrowser-tab[selected] .tab-background,
.tabbrowser-tab[visuallyselected] .tab-background,
.tab-background[selected] {{
    background-color: {surface1} !important;
    background-image: none !important;
    border-top: 2px solid {mauve} !important;
}}
.tabbrowser-tab:not([selected]):hover .tab-background,
.tab-background:not([selected]):hover {{
    background-color: {surface0} !important;
    background-image: none !important;
}}
.tabbrowser-tab {{
    color: {text} !important;
}}
.tabbrowser-tab[selected],
.tabbrowser-tab[visuallyselected] {{
    color: {rosewater} !important;
    font-weight: bold !important;
}}
.tab-line {{
    background-color: {mauve} !important;
}}

/* URL / Search Bar */
#urlbar-background {{
    background-color: {surface0} !important;
    border: 1px solid {surface1} !important;
    border-radius: 8px !important;
}}
#urlbar[focused] > #urlbar-background,
#urlbar[open] > #urlbar-background {{
    background-color: {surface1} !important;
    border-color: {mauve} !important;
}}
#urlbar-input {{
    color: {text} !important;
}}
#urlbar-results {{
    background-color: {surface0} !important;
    color: {text} !important;
}}
.urlbarView-row[selected] {{
    background-color: {surface1} !important;
}}

/* Toolbar buttons */
toolbarbutton {{
    color: {text} !important;
}}
toolbarbutton:hover:not([disabled="true"]) {{
    background-color: {surface0} !important;
}}

/* Identity icon & bookmark star */
#identity-box {{
    color: {mauve} !important;
}}

/* Sidebar & Findbar */
#sidebar-box,
#sidebar-header,
findbar {{
    background-color: {base} !important;
    color: {text} !important;
    border-color: {surface1} !important;
}}
"""

    user_content_content = f"""/* Qtile-Con dynamic global theme colors */
:root {{
    color-scheme: {color_scheme} !important;
}}

@-moz-document url("about:blank"), url("about:newtab"), url("about:home"), url("about:privatebrowsing") {{
    :root, body {{
        color-scheme: {color_scheme} !important;
        --newtab-background-color: {base} !important;
        --newtab-text-primary-color: {text} !important;
        --newtab-wordmark-color: {mauve} !important;
        background-color: {base} !important;
        color: {text} !important;
    }}
}}
"""

    profiles = []
    for d in mozilla_dir.iterdir():
        if d.is_dir() and ((d / "prefs.js").is_file() or "default" in d.name.lower()):
            profiles.append(d)

    for profile_dir in profiles:
        # 1. Update user.js ensuring dynamic values update cleanly
        ujs = profile_dir / "user.js"
        existing_lines = []
        if ujs.is_file():
            try:
                existing_lines = ujs.read_text(encoding="utf-8").splitlines()
            except OSError:
                existing_lines = []
        clean_lines = [
            line for line in existing_lines
            if not any(k in line for k in managed_keys) and "Qtile-Con dynamic" not in line
        ]
        ujs_text = "\n".join(clean_lines).strip()
        if ujs_text:
            ujs_text += "\n\n"
        ujs_text += "\n".join(managed_prefs) + "\n"
        try:
            ujs.write_text(ujs_text, encoding="utf-8")
        except OSError:
            pass

        # 2. Update prefs.js
        pjs = profile_dir / "prefs.js"
        if pjs.is_file():
            try:
                pjs_lines = pjs.read_text(encoding="utf-8").splitlines()
                pjs_clean = [
                    line for line in pjs_lines
                    if not any(f'"{k}"' in line for k in managed_keys)
                ]
                pjs_clean.extend(managed_prefs[1:])
                pjs.write_text("\n".join(pjs_clean) + "\n", encoding="utf-8")
            except OSError:
                pass

        # 3. Write userChrome.css
        chrome_dir = profile_dir / "chrome"
        chrome_dir.mkdir(exist_ok=True)
        css_file = chrome_dir / "userChrome.css"
        try:
            css_file.write_text(user_chrome_content, encoding="utf-8")
        except OSError:
            pass

        # 4. Write userContent.css
        uc_file = chrome_dir / "userContent.css"
        try:
            uc_file.write_text(user_content_content, encoding="utf-8")
        except OSError:
            pass

    # Clear Firefox startupCache to prevent stale cached CSS
    cache_dirs = [Path.home() / ".cache" / "mozilla" / "firefox"]
    for croot in cache_dirs:
        if croot.is_dir():
            for sc in croot.glob("*/startupCache"):
                try:
                    shutil.rmtree(sc, ignore_errors=True)
                except Exception:
                    pass

    # If Firefox is running, restart it smoothly to reload the theme live
    if restart_if_running and os.environ.get("QTILE_THEME_NO_RESTART_FIREFOX", "0") != "1":
        # Check if firefox or firefox-esr is running
        check = subprocess.run(["pgrep", "-f", "firefox"], capture_output=True)
        if check.returncode == 0:
            bin_path = shutil.which("firefox-esr") or shutil.which("firefox") or "/usr/bin/firefox-selector"
            # Graceful termination (SIGTERM allows Firefox to save session and tab state)
            subprocess.run(["pkill", "-15", "-f", "firefox-esr|firefox"], stderr=subprocess.DEVNULL)
            import time
            for _ in range(60):
                time.sleep(0.1)
                pids = subprocess.run(["pgrep", "-f", "firefox"], capture_output=True).stdout.strip()
                lock_exists = any((p / "parent.lock").exists() for p in profiles)
                if not pids and not lock_exists:
                    break

            # Force kill if still hung
            pids = subprocess.run(["pgrep", "-f", "firefox"], capture_output=True).stdout.strip()
            if pids:
                subprocess.run(["pkill", "-9", "-f", "firefox-esr|firefox"], stderr=subprocess.DEVNULL)
                time.sleep(0.2)

            for p in profiles:
                (p / "parent.lock").unlink(missing_ok=True)

            # Update prefs.js after Firefox has closed so Firefox won't overwrite on exit
            for profile_dir in profiles:
                pjs = profile_dir / "prefs.js"
                if pjs.is_file():
                    try:
                        pjs_lines = pjs.read_text(encoding="utf-8").splitlines()
                        pjs_clean = [
                            line for line in pjs_lines
                            if not any(f'"{k}"' in line for k in managed_keys)
                        ]
                        pjs_clean.extend(managed_prefs[1:])
                        pjs.write_text("\n".join(pjs_clean) + "\n", encoding="utf-8")
                    except OSError:
                        pass

            # Clear cache again
            for croot in cache_dirs:
                if croot.is_dir():
                    for sc in croot.glob("*/startupCache"):
                        try:
                            shutil.rmtree(sc, ignore_errors=True)
                        except Exception:
                            pass

            time.sleep(0.2)
            # Relaunch in background with guaranteed DISPLAY
            env = os.environ.copy()
            if "DISPLAY" not in env:
                env["DISPLAY"] = ":0"
            subprocess.Popen(
                [bin_path],
                env=env,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
                cwd=str(Path.home())
            )


def generate_rofi_theme(palette, theme_name):
    base = palette.get("base", "#1e1e2e")
    surface0 = palette.get("surface0", "#313244")
    surface1 = palette.get("surface1", "#45475a")
    overlay = palette.get("overlay", "#6c7086")
    text = palette.get("text", "#cdd6f4")
    mauve = palette.get("mauve", "#cba6f7")
    rosewater = palette.get("rosewater", text)

    run_bin = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "qtile/scripts/qtile-run"
    return f"""/* Dynamic Qtile-Con Rofi Theme — {theme_name} */
configuration {{
    show-icons: true;
    icon-theme: "Adwaita";
    modes: "combi,drun,run";
    combi-modes: "drun,run";
    combi-hide-mode-prefix: true;
    drun-match-fields: "name,generic,exec";
    display-combi: "󰍉 All";
    display-drun: "󰣆 Apps";
    display-run: "󰌌 Run";
    display-file: "󰈞 File";
    display-files: "󰈞 File";
    display-content: "󰈬 Content";
    terminal: "alacritty";
    run-command: "qtile-run {{cmd}}";
    run-shell-command: "qtile-run {{cmd}}";
    sidebar-mode: true;
    kb-mode-next: "Shift+Right,Control+Tab";
    kb-mode-previous: "Shift+Left,Control+ISO_Left_Tab";
}}
* {{ font: "JetBrainsMono Nerd Font 10.5"; background-color: transparent; text-color: {text}; }}
window {{ location: center; anchor: center; width: 38%; border: 2px; border-color: {mauve}; border-radius: 12px; background-color: {base}; padding: 14px; }}
mainbox {{ background-color: {base}; spacing: 8px; children: [ inputbar, message, listview, mode-switcher ]; }}
inputbar {{ background-color: {surface0}; border: 1px; border-color: {surface1}; border-radius: 8px; padding: 7px 10px; children: [ prompt, entry ]; spacing: 8px; }}
prompt {{ text-color: {mauve}; }}
entry {{ placeholder: "Search…"; placeholder-color: {overlay}; text-color: {text}; }}
message {{ background-color: {surface0}; border-radius: 6px; padding: 6px 10px; }}
listview {{ background-color: {base}; lines: 7; columns: 1; fixed-height: false; spacing: 3px; scrollbar: false; }}
element {{ background-color: {base}; border-radius: 6px; padding: 5px 8px; spacing: 8px; }}
element selected {{ background-color: {surface1}; text-color: {rosewater}; border: 1px; border-color: {mauve}; }}
element-icon {{ size: 1.25em; margin: 0 8px 0 0; background-color: inherit; }}
element-text {{ background-color: inherit; text-color: inherit; }}
mode-switcher {{ background-color: transparent; spacing: 4px; }}
button {{ background-color: {surface0}; text-color: {text}; border-radius: 6px; padding: 4px 6px; }}
button selected {{ background-color: {mauve}; text-color: {base}; }}
"""



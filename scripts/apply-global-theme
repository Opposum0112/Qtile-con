    import json
    content = json.dumps(fastfetch_config, indent=4)
    user_ff = Path.home() / ".config" / "fastfetch" / "config.jsonc"
    try:
        user_ff.parent.mkdir(parents=True, exist_ok=True)
        user_ff.write_text(content, encoding="utf-8")
    except OSError:
        pass

    repo_ff = Path(__file__).resolve().parent.parent / "fastfetch" / "config.jsonc"
    try:
        if repo_ff.parent.is_dir():
            repo_ff.write_text(content, encoding="utf-8")
    except OSError:
        pass


def reload_qtile():
    """Trigger a live in-process reload of Qtile config so status bar and widgets update instantly."""
    try:
        from libqtile.command.client import InteractiveCommandClient
        c = InteractiveCommandClient()
        c.eval("import sys\nfor m in list(sys.modules.keys()):\n    if m.startswith('qtile_config'):\n        del sys.modules[m]")
        c.reload_config()
        return True
    except Exception:
        pass

    res = subprocess.run(["qtile", "cmd-obj", "-o", "cmd", "-f", "reload_config"], stderr=subprocess.DEVNULL)
    if res.returncode != 0:
        subprocess.run(["qtile", "cmd-obj", "-o", "cmd", "-f", "restart"], stderr=subprocess.DEVNULL)
    return True


def main():
    if "--help" in sys.argv or "-h" in sys.argv:
        print("Usage: apply-global-theme <theme_json_file_or_name> [--no-restart-firefox]")
        sys.exit(0)
    restart_firefox = "--no-restart-firefox" not in sys.argv and os.environ.get("QTILE_THEME_NO_RESTART_FIREFOX", "0") != "1"
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    if not args:
        print("Usage: apply-global-theme <theme_json_file_or_name> [--no-restart-firefox]")
        sys.exit(1)

    arg = args[0].strip()
    theme_path = Path(arg)
    if not theme_path.is_file():
        # Look in repo themes or ~/.config/qtile/themes
        candidates = [
            Path(__file__).resolve().parent.parent / "themes" / f"{arg}.json",
            Path(__file__).resolve().parent.parent / "themes" / f"{arg}-dark.json",
            Path(__file__).resolve().parent.parent / "themes" / arg,
            Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "qtile/themes" / f"{arg}.json",
            Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "qtile/themes" / f"{arg}-dark.json",
            Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "qtile/themes" / arg,
        ]
        for c in candidates:
            if c.is_file():
                theme_path = c
                break

    if not theme_path.is_file():
        print(f"Error: Theme file {arg} not found.")
        sys.exit(1)

    theme_name = theme_path.stem
    data = load_theme(theme_path)
    palette = data.get("colors") or data.get("palette") or data

    apply_qtile(palette, theme_name)
    apply_alacritty(palette)
    apply_kitty(palette)
    apply_micro(palette, theme_name)
    apply_firefox(palette, theme_name, restart_if_running=restart_firefox)
    apply_dunst(palette)
    apply_rofi(palette, theme_name)
    apply_thunar_and_gtk(palette, theme_name)
    apply_yazi(palette, theme_name)
    apply_helix(palette, theme_name)
    apply_fastfetch(palette, theme_name)

    # Reload Qtile palette and status bar live
    reload_qtile()

    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "Global Theme Applied", f"Updated Qtile, Alacritty, Kitty, Micro, Firefox, Dunst, Thunar, Yazi, Fastfetch, and Rofi to {theme_name}."])
    print(f"Global theme successfully applied: {theme_name}")


if __name__ == "__main__":
    main()


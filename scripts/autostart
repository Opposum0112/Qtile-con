#!/usr/bin/env bash
set -euo pipefail
mkdir -p "$HOME/Pictures/Wallpapers" "$HOME/Pictures/Screenshots" "$HOME/.cache"
# Restore the last wallpaper selected with set-wallpaper.
state="$HOME/.cache/qtile-wallpaper"
if command -v feh >/dev/null 2>&1 && [[ -r "$state" ]]; then
  wallpaper="$(cat "$state")"
  [[ -f "$wallpaper" ]] && feh --no-fehbg --bg-fill "$wallpaper"
fi
# Optional X11 clipboard history.
if command -v greenclip >/dev/null 2>&1; then
  pgrep -x greenclip >/dev/null 2>&1 || greenclip daemon &
fi
# Network applet is optional.
if command -v nm-applet >/dev/null 2>&1; then nm-applet --indicator & fi

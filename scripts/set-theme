#!/usr/bin/env bash
set -euo pipefail
base="$(dirname "$0")/../themes"
choice="$(find "$base" -maxdepth 1 -type f -name '*.json' -printf '%f\n' | sort | fuzzel --dmenu --prompt='Theme > ' || true)"
[[ -n "$choice" ]] || exit 0
python3 "$(dirname "$0")/theme_apply.py" "$base/$choice"
if command -v notify-send >/dev/null 2>&1; then notify-send "Qtile theme" "Applied $choice. Restart Qtile if colors do not refresh."; fi

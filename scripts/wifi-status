#!/usr/bin/env bash
set -u

# Check Wi-Fi state using nmcli; fall back gracefully if unavailable
if ! command -v nmcli >/dev/null 2>&1; then
  printf '󰖪 N/A\n'
  exit 0
fi

radio="$(nmcli radio wifi 2>/dev/null || echo "disabled")"
if [[ "$radio" == "disabled" ]]; then
  printf '󰖪 Off\n'
  exit 0
fi

active="$(nmcli -t -f active,ssid dev wifi 2>/dev/null | grep '^yes:' | cut -d: -f2 | head -n1 || true)"
if [[ -n "$active" ]]; then
  # Truncate if unusually long to keep bar neat
  if ((${#active} > 14)); then
    active="${active:0:12}…"
  fi
  printf '󰖩 %s\n' "$active"
  exit 0
fi

# Fallback: check general network connectivity (Ethernet/Wired)
state="$(nmcli -t -f STATE general status 2>/dev/null || echo "disconnected")"
if [[ "$state" == "connected" ]]; then
  printf '󰈀 Online\n'
  exit 0
fi

printf '󰖪 Disconnected\n'

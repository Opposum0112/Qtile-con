#!/usr/bin/env bash
set -euo pipefail
mode="${1:-region}"
outdir="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
mkdir -p "$outdir"
file="$outdir/$(date +'%Y-%m-%d_%H-%M-%S').png"
case "$mode" in
  full) grim "$file" ;;
  region) grim -g "$(slurp)" "$file" ;;
  *) echo "Usage: screenshot [full|region]" >&2; exit 2 ;;
esac
if command -v wl-copy >/dev/null 2>&1; then wl-copy < "$file"; fi
notify-send "Screenshot saved" "$file"

#!/usr/bin/env python3
"""Snapper Btrfs snapshot listing, status monitoring, and immediate rollback for Qtile SysAdmin."""
import json
import os
import subprocess
import sys

THEME = os.path.expanduser("~/.config/qtile/themes/catppuccin-mocha.rasi")


def get_snapshots():
    """Fetch and parse snapshots for the root btrfs subvolume."""
    snapshots = []
    current_snap = "0"
    try:
        proc = subprocess.run(
            ["snapper", "-c", "root", "list"],
            capture_output=True,
            text=True,
            check=True,
        )
        lines = proc.stdout.strip().split("\n")
        if len(lines) >= 3:
            for line in lines[2:]:
                parts = [p.strip() for p in line.split("|")]
                if len(parts) >= 7:
                    num_raw = parts[0]
                    stype = parts[1]
                    pre = parts[2]
                    date = parts[3]
                    user = parts[4]
                    cleanup = parts[5]
                    desc = parts[6] if len(parts) > 6 else ""
                    clean_num = num_raw.replace("*", "").replace("+", "").strip()
                    is_current = "+" in num_raw
                    if is_current:
                        current_snap = clean_num
                    snapshots.append({
                        "num": clean_num,
                        "raw_num": num_raw,
                        "type": stype,
                        "date": date,
                        "user": user,
                        "cleanup": cleanup,
                        "desc": desc,
                        "is_current": is_current,
                    })
    except Exception:
        pass
    return snapshots, current_snap


def status_json():
    """Output JSON payload for Qtile status bar widget."""
    snapshots, current_snap = get_snapshots()
    count = len(snapshots)
    if count == 0:
        summary = "󰁯 Snaps"
        tooltip = "Snapper: No snapshots found\nClick: Open Snapshot Management"
    else:
        newest = snapshots[-1]
        summary = f"󰁯 {count} snaps"
        tooltip = (
            f"Btrfs Snapshots (Root Config)\n"
            f"Total Snapshots: {count}\n"
            f"Current Active: #{current_snap}\n"
            f"Latest Snapshot: #{newest['num']} ({newest['desc'] or 'snapshot'})\n"
            f"Date: {newest['date']}\n"
            f"Click: Immediate Rollback Menu | Right-Click: New Snapshot"
        )

    data = {
        "summary": summary,
        "tooltip": tooltip,
        "count": count,
        "current": current_snap,
    }
    print(json.dumps(data, ensure_ascii=False))


def create_snapshot():
    """Prompt for snapshot description and create manual snapshot."""
    rofi_cmd = ["rofi", "-dmenu", "-i", "-p", "New Snapshot Description > "]
    if os.path.isfile(THEME):
        rofi_cmd.extend(["-theme", THEME])

    proc = subprocess.run(rofi_cmd, input="Manual safety backup\n", capture_output=True, text=True)
    desc = proc.stdout.strip()
    if not desc:
        return

    try:
        res = subprocess.run(
            ["snapper", "-c", "root", "create", "-d", desc],
            capture_output=True,
            text=True,
            check=True,
        )
        subprocess.run([
            "notify-send", "-i", "system-software-update",
            "Snapper Snapshot Created", f"Successfully created snapshot: '{desc}'"
        ])
    except Exception as e:
        subprocess.run([
            "notify-send", "-i", "dialog-error",
            "Snapper Error", f"Failed to create snapshot: {e}"
        ])


def show_rollback_menu():
    """Interactive Rofi menu of snapshots for immediate rollback."""
    snapshots, current_snap = get_snapshots()
    if not snapshots:
        subprocess.run(["notify-send", "-i", "dialog-warning", "Snapper", "No snapshots available to rollback."])
        return

    options = []
    snap_map = {}

    options.append("󰄬  Create New Safety Snapshot Now")
    options.append("󰑐  Refresh Snapshots List")
    options.append("────────────────────────────────────────────────────────────────")

    # Reverse order so newest snapshots appear first
    for s in reversed(snapshots):
        num_str = f"#{s['num']:>3}"
        current_marker = "  (ACTIVE CURRENT)" if s["is_current"] else ""
        date_short = s["date"]
        # Shorten date representation if standard format
        if " IST" in date_short:
            date_short = date_short.replace(" IST", "")
        desc_str = s["desc"] or s["type"]
        entry = f"󰁯  {num_str}  |  {date_short:<25}  |  [{s['type']:<6}]  |  {desc_str}{current_marker}"
        options.append(entry)
        snap_map[entry] = s

    options.append("󰅖  Cancel")

    rofi_cmd = ["rofi", "-dmenu", "-i", "-p", f"Snapper Rollback ({len(snapshots)} snapshots) > "]
    if os.path.isfile(THEME):
        rofi_cmd.extend(["-theme", THEME])

    proc = subprocess.run(rofi_cmd, input="\n".join(options), capture_output=True, text=True)
    choice = proc.stdout.strip()

    if not choice or "Cancel" in choice or "──────" in choice:
        return

    if "Create New Safety Snapshot" in choice:
        create_snapshot()
        return

    if "Refresh Snapshots" in choice:
        show_rollback_menu()
        return

    if choice in snap_map:
        target = snap_map[choice]
        target_num = target["num"]
        desc = target["desc"] or target["type"]

        # Action sub-menu for the selected snapshot
        action_options = [
            f"󰁯  IMMEDIATE ROLLBACK to Snapshot #{target_num} ({desc})",
            f"󰈈  View Snapshot #{target_num} Details",
            f"󰆴  Delete Snapshot #{target_num}",
            f"󰅖  Cancel",
        ]

        act_proc = subprocess.run(
            ["rofi", "-dmenu", "-i", "-p", f"Snapshot #{target_num} Action > "] + (["-theme", THEME] if os.path.isfile(THEME) else []),
            input="\n".join(action_options),
            capture_output=True,
            text=True,
        )
        action = act_proc.stdout.strip()
        if not action or "Cancel" in action:
            return

        if "IMMEDIATE ROLLBACK" in action:
            # Confirmation step for safety
            confirm_options = [
                f"󰁯  CONFIRM: Immediate Rollback to Snapshot #{target_num}",
                f"󰅖  Cancel",
            ]
            conf_proc = subprocess.run(
                ["rofi", "-dmenu", "-i", "-p", f"CONFIRM ROLLBACK to #{target_num}? > "] + (["-theme", THEME] if os.path.isfile(THEME) else []),
                input="\n".join(confirm_options),
                capture_output=True,
                text=True,
            )
            confirm = conf_proc.stdout.strip()
            if not confirm or "Cancel" in confirm:
                return

            # Perform Immediate Rollback:
            # 1. Create safety backup snapshot
            subprocess.run(["notify-send", "-i", "system-software-update", "Snapper Rollback", f"Creating pre-rollback safety backup..."])
            subprocess.run(["snapper", "-c", "root", "create", "-d", f"Safety backup before rollback to #{target_num}"])

            # 2. Run snapper rollback with pkexec
            rb_cmd = ["pkexec", "--disable-internal-agent", "snapper", "rollback", target_num, "-d", f"Rollback to #{target_num} via Qtile SysAdmin"]
            rb_proc = subprocess.run(rb_cmd, capture_output=True, text=True)

            if rb_proc.returncode == 0:
                subprocess.run([
                    "notify-send", "-u", "critical", "-i", "system-software-update",
                    "Snapper Rollback Complete!",
                    f"Active subvolume successfully rolled back to Snapshot #{target_num}.\nA system reboot is required to boot into the restored snapshot."
                ])

                # Prompt for reboot
                reboot_options = [
                    "󰜗  Reboot System Now",
                    "󰅖  Reboot Later",
                ]
                reb_proc = subprocess.run(
                    ["rofi", "-dmenu", "-i", "-p", "Reboot to apply rollback? > "] + (["-theme", THEME] if os.path.isfile(THEME) else []),
                    input="\n".join(reboot_options),
                    capture_output=True,
                    text=True,
                )
                if "Reboot System Now" in reb_proc.stdout:
                    subprocess.run(["systemctl", "reboot"])
            else:
                err_msg = rb_proc.stderr.strip() or "Rollback failed"
                subprocess.run(["notify-send", "-u", "critical", "-i", "dialog-error", "Rollback Error", err_msg])

        elif "View Snapshot" in action:
            terminal = os.environ.get("QTILE_TERMINAL", "alacritty")
            subprocess.Popen([
                terminal, "-e", "bash", "-c",
                f"echo 'Snapshot #{target_num} Information:'; echo ''; snapper -c root status 0..{target_num} 2>&1 | head -n 50 ; echo ''; read -p 'Press Enter to close...'"
            ], start_new_session=True)

        elif "Delete Snapshot" in action:
            del_proc = subprocess.run(
                ["snapper", "-c", "root", "delete", target_num],
                capture_output=True,
                text=True,
            )
            if del_proc.returncode == 0:
                subprocess.run(["notify-send", "-i", "trash-empty", "Snapper", f"Deleted Snapshot #{target_num}"])
            else:
                subprocess.run(["notify-send", "-i", "dialog-error", "Snapper Error", f"Could not delete: {del_proc.stderr}"])


if __name__ == "__main__":
    mode = sys.argv[1] if len(sys.argv) > 1 else "--status"
    if mode in ("--rollback-menu", "--menu", "-m"):
        show_rollback_menu()
    elif mode in ("--create", "-c"):
        create_snapshot()
    else:
        status_json()

#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/qtile"
THEME="${QTILE_ROFI_THEME:-$CONFIG_DIR/themes/catppuccin-mocha.rasi}"
if [[ ! -f "$THEME" && -f "$(dirname "$0")/../themes/catppuccin-mocha.rasi" ]]; then
  THEME="$(dirname "$0")/../themes/catppuccin-mocha.rasi"
fi

vol_status="$("$(dirname "$0")/volume-status" 2>/dev/null || echo "󰕾")"

options=(
  "󰕾  100%  Max Volume"
  "󰖀   80%  High Volume"
  "󰖀   60%  Medium Volume"
  "󰕿   40%  Low Volume"
  "󰕿   20%  Quiet Volume"
  "󰝟  Toggle Mute / Unmute"
  "󰝝  Increase Volume (+5%)"
  "󰝞  Decrease Volume (-5%)"
  "󰍛  Audio Mixer (pavucontrol)"
  "󰅖  Cancel"
)

choice="$(printf '%s\n' "${options[@]}" | rofi -dmenu -i -p "Volume ($vol_status) > " -theme "$THEME" || true)"
[[ -n "$choice" ]] || exit 0

set_vol() {
  local target="$1"
  if command -v pamixer >/dev/null 2>&1; then
    pamixer --set-volume "$target"
  elif command -v pactl >/dev/null 2>&1; then
    pactl set-sink-volume @DEFAULT_SINK@ "${target}%"
  elif command -v amixer >/dev/null 2>&1; then
    amixer -q set Master "${target}%"
  fi
}

toggle_mute() {
  if command -v pamixer >/dev/null 2>&1; then
    pamixer --toggle-mute
  elif command -v pactl >/dev/null 2>&1; then
    pactl set-sink-mute @DEFAULT_SINK@ toggle
  elif command -v amixer >/dev/null 2>&1; then
    amixer -q set Master toggle
  fi
}

change_vol() {
  local delta="$1"
  if command -v pamixer >/dev/null 2>&1; then
    if [[ "$delta" == +* ]]; then
      pamixer --increase "${delta#+}"
    else
      pamixer --decrease "${delta#-}"
    fi
  elif command -v pactl >/dev/null 2>&1; then
    pactl set-sink-volume @DEFAULT_SINK@ "${delta}%"
  elif command -v amixer >/dev/null 2>&1; then
    if [[ "$delta" == +* ]]; then
      amixer -q set Master "${delta#+}%+"
    else
      amixer -q set Master "${delta#-}%-"
    fi
  fi
}

case "$choice" in
  *"100%"*) set_vol 100 ;;
  *"80%"*)  set_vol 80 ;;
  *"60%"*)  set_vol 60 ;;
  *"40%"*)  set_vol 40 ;;
  *"20%"*)  set_vol 20 ;;
  *"Toggle Mute"*) toggle_mute ;;
  *"+5%"*) change_vol "+5" ;;
  *"-5%"*) change_vol "-5" ;;
  *"Audio Mixer"*)
    if command -v pavucontrol >/dev/null 2>&1; then
      nohup pavucontrol >/dev/null 2>&1 &
    else
      term="${QTILE_TERMINAL:-alacritty}"
      command -v "$term" >/dev/null 2>&1 || term=alacritty
      nohup "$term" -e alsamixer >/dev/null 2>&1 &
    fi
    exit 0
    ;;
  *) exit 0 ;;
esac

# Notify Qtile to refresh and notify desktop
new_status="$("$(dirname "$0")/volume-status" 2>/dev/null || echo "")"
command -v notify-send >/dev/null 2>&1 && notify-send -t 1500 "Volume" "Current: $new_status"

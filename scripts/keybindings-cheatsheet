        ("External Integration", "󰒋", "witr", home_dir / ".local" / "bin" / "witr", repo_dir / "bin" / "witr", "Process causation tree tracer binary"),
        ("External Integration", "󰆍", ".bashrc", home_dir / ".bashrc", home_dir / ".bashrc", "Interactive user Bash shell configuration and unified PATH export"),
        ("External Integration", "󰆍", ".profile", home_dir / ".profile", home_dir / ".profile", "User login session environment profile and PATH configuration"),
        ("External Integration", "󰈙", "SETTINGS_GUIDE.md", config_dir / "SETTINGS_GUIDE.md", repo_dir / "docs" / "SETTINGS_GUIDE.md", "Comprehensive systems architecture, customization, and settings guide"),
        ("Input & Security", "󰌌", "udev/90-backlight.rules", Path("/etc/udev/rules.d/90-backlight.rules"), repo_dir / "udev" / "90-backlight.rules", "Udev rules granting video/input groups passwordless backlight control"),
        ("External Integration", "󰒋", "yazi/yazi.toml", home_dir / ".config/yazi/yazi.toml", home_dir / ".config/yazi/yazi.toml", "Yazi asynchronous terminal file manager configuration"),
        ("External Integration", "󰏘", "yazi/theme.toml", home_dir / ".config/yazi/theme.toml", home_dir / ".config/yazi/theme.toml", "Yazi theme flavor selector configuration"),
        ("External Integration", "󰉋", "gtk-3.0/settings.ini", home_dir / ".config/gtk-3.0/settings.ini", home_dir / ".config/gtk-3.0/settings.ini", "GTK3 and Thunar widget/icon theme settings (Tela icon theme)"),
    ]

    configs = []
    for category, icon, name, active_path, source_path, description in raw_entries:
        target_path = active_path if active_path.exists() else source_path
        exists = active_path.exists() or source_path.exists()
        is_dir = target_path.is_dir() if exists else False
        is_exec = os.access(target_path, os.X_OK) if exists and not is_dir else False

        size_bytes = 0
        mtime_str = None
        if exists:
            try:
                st = target_path.stat()
                size_bytes = st.st_size
                mtime_str = datetime.fromtimestamp(st.st_mtime).strftime("%Y-%m-%d %H:%M")
            except Exception:
                pass

        if active_path.is_dir():
            status = "Directory"
        elif active_path.is_file():
            status = "Active"
        elif source_path.exists():
            status = "In Repo"
        else:
            status = "Not Found"

        display_path = str(active_path).replace(str(home_dir), "~")
        source_display = str(source_path).replace(str(home_dir), "~")

        configs.append({
            "category": category,
            "icon": icon,
            "name": name,
            "description": description,
            "active_path": str(active_path),
            "display_path": display_path,
            "source_path": str(source_path),
            "source_display": source_display,
            "target_path": str(target_path),
            "exists": exists,
            "status": status,
            "size_bytes": size_bytes,
            "size_formatted": format_file_size(size_bytes) if exists else "0 B",
            "last_modified": mtime_str,
            "is_dir": is_dir,
            "is_executable": is_exec,
        })

    return configs


def get_guide_sections():
    """Structured sections from SETTINGS_GUIDE.md."""
    return [
        {"icon": "󰍹", "title": "1. System Architecture & Modular Layout", "description": "Modular Python Qtile configuration, config.py hooks, layouts, and bar widgets"},
        {"icon": "󰏘", "title": "2. Color Theme Customization & Multi-App Sync", "description": "Adding new themes, JSON palette schema, Alacritty, Kitty, Micro, and Rofi live sync"},
        {"icon": "󰌌", "title": "3. Hardware Controls & Mac Ergonomics", "description": "Mac screenshots (Cmd+Shift+3/4), brightnessctl, video/input udev rules, backlight setup"},
        {"icon": "󰒓", "title": "4. PolicyKit Management & Root GUI Authentication", "description": "Graphical root elevation (lxpolkit), auto-centering floating rules for auth prompts"},
        {"icon": "󰒋", "title": "5. Qtile Bar Widget Interactions & Memory Lock", "description": "Process watchdog (SIGTERM kill), window title expander, <800MB RAM idle lock"},
        {"icon": "󰉋", "title": "6. File Management Integration (Thunar & Yazi)", "description": "Thunar plugins, Tela icon themes, and Yazi fast asynchronous terminal file manager"},
        {"icon": "󰈙", "title": "7. Interactive Reference & Cheatsheet Architecture", "description": "Tabbed cheatsheet launcher, Rofi modes, and config file inspection"},
        {"icon": "󰕰", "title": "8. Independent Workspace Layouts (Zero-Leakage)", "description": "Per-workspace persistent layout memory, zero-leakage switching, cache engine"},
        {"icon": "󰠬", "title": "9. SysAdmin Widget Group & Immediate Rollback", "description": "Expandable bar capsule, Cockpit console, AI Agents monitor, and Snapper Btrfs rollback"},

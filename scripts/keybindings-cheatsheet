#!/usr/bin/env python3
"""Unified Tabbed Shortcuts & Keybindings Reference Palette for Qtile-Con.

Provides an interactive tabbed launcher with 8 dedicated modes/tabs:
  1. Qtile & Gestures (Dynamic real-time parsing from qtile_config/keys.py & libinput gestures)
  2. Config (Environment Configuration Files & Locations Browser)
  3. Guide (Systems Architecture & Settings Documentation Guide)
  4. Kitty (Kitty GPU Terminal Emulator Keybindings & Kittens)
  5. Micro (Micro Terminal Text Editor Keybindings & Multi-cursor)
  6. Helix (Helix Modal Editor Keybindings & Kakoune Selection Navigation)
  7. Yazi (Yazi Asynchronous Terminal File Manager Keybindings)
  8. Nano (GNU Nano Editor Keybindings & Navigation)

Qtile keybindings are parsed dynamically on every launch so that any modification
to qtile_config/keys.py is automatically and immediately reflected in the cheatsheet.
"""
import ast
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path

# Ensure UTF-8 locale
os.environ["LANG"] = os.environ.get("LANG", "en_US.UTF-8")
os.environ["LC_ALL"] = os.environ.get("LC_ALL", "en_US.UTF-8")


def get_theme_path():
    """Resolve active Rofi theme matching the theme selector."""
    config_dir = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "qtile"
    theme = os.environ.get("QTILE_ROFI_THEME", str(config_dir / "themes/catppuccin-mocha.rasi"))
    if not os.path.isfile(theme):
        repo_theme = Path(__file__).resolve().parent.parent / "themes/catppuccin-mocha.rasi"
        if repo_theme.is_file():
            theme = str(repo_theme)
    return theme


def get_scripts_dir():
    config_scripts = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "qtile/scripts"
    if config_scripts.is_dir():
        return str(config_scripts)
    return str(Path(__file__).resolve().parent)


SCRIPTS = get_scripts_dir()


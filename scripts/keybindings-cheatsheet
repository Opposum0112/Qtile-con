# ==============================================================================
# 2. DYNAMIC QTILE KEYBINDINGS LOADER
# ==============================================================================
def get_qtile_keybindings():
    """Dynamically load and parse Qtile keyboard shortcuts from qtile_config/keys.py.

    Guarantees that any changes made to keys.py are automatically and immediately
    reflected in the cheatsheet without requiring manual updates to the catalog.
    """
    config_dir = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "qtile"
    active_keys_file = config_dir / "qtile_config" / "keys.py"
    repo_keys_file = Path(__file__).resolve().parent.parent / "qtile_config" / "keys.py"

    custom_keys = os.environ.get("QTILE_KEYS_FILE")
    if custom_keys and Path(custom_keys).is_file():
        keys_file = Path(custom_keys)
    elif active_keys_file.is_file() and repo_keys_file.is_file():
        try:
            if repo_keys_file.stat().st_mtime >= active_keys_file.stat().st_mtime:
                keys_file = repo_keys_file
            else:
                keys_file = active_keys_file
        except OSError:
            keys_file = active_keys_file
    elif active_keys_file.is_file():
        keys_file = active_keys_file
    else:
        keys_file = repo_keys_file

    keys_list = []
    if keys_file.is_file():
        try:
            sys_path_added = str(keys_file.parent.parent)
            if sys_path_added not in sys.path:
                sys.path.insert(0, sys_path_added)
            import importlib.machinery
            import importlib.util
            loader = importlib.machinery.SourceFileLoader("qtile_keys_live", str(keys_file))
            spec = importlib.util.spec_from_loader("qtile_keys_live", loader)
            if spec:
                keys_mod = importlib.util.module_from_spec(spec)
                loader.exec_module(keys_mod)
                keys_list = getattr(keys_mod, "keys", [])
        except Exception as e:
            sys.stderr.write(f"Notice: Loading dynamic keys from {keys_file}: {e}\n")

    if not keys_list:
        try:
            from qtile_config.keys import keys as fallback_keys
            keys_list = fallback_keys
        except Exception:
            pass

    MOD_MAP = {"mod4": "Super", "mod1": "Alt", "control": "Ctrl", "shift": "Shift"}
    KEY_MAP = {
        "Return": "Return", "space": "Space", "Escape": "Escape", "Tab": "Tab",
        "bracketleft": "[", "bracketright": "]", "equal": "=", "minus": "-",
        "comma": ", (comma)", "period": ". (period)", "slash": "/", "question": "?",
        "Left": "Left", "Right": "Right", "Up": "Up", "Down": "Down"
    }

    dynamic_items = []
    seen_combos = set()

    for k in keys_list:
        parts = [MOD_MAP[m] for m in ["mod4", "control", "shift", "mod1"] if m in getattr(k, "modifiers", [])]
        raw_key = getattr(k, "key", "")
        parts.append(KEY_MAP.get(raw_key, raw_key))
        combo = " + ".join(parts)

        if combo in seen_combos:
            continue
        seen_combos.add(combo)

        commands = getattr(k, "commands", [])
        first_cmd = commands[0] if commands else None
        cmd_name = first_cmd.name if first_cmd else ""
        args = first_cmd.args if (first_cmd and first_cmd.args) else ()
        arg0 = str(args[0]) if args else ""

        explicit_desc = getattr(k, "desc", "") or ""
        desc = explicit_desc
        icon = "󰌌"
        cat = "Window Focus & Layout"
        action = ""

        if cmd_name == "spawn":
            action = arg0
            matched = False
            for target_substr, (s_icon, s_cat, s_desc) in CMD_DESCRIPTIONS.items():
                if target_substr in arg0:
                    icon, cat = s_icon, s_cat
                    desc = explicit_desc or s_desc
                    matched = True
                    break
            if not matched:
                icon = "󰆍"
                cat = "Launchers & Tools"
                base_cmd = os.path.basename(arg0.split()[0]) if arg0 else "command"
                desc = explicit_desc or f"Launch {base_cmd}"
        elif cmd_name in LAZY_DESCRIPTIONS:
            icon, cat, default_desc = LAZY_DESCRIPTIONS[cmd_name]
            desc = explicit_desc or default_desc
            action = f"qtile cmd-obj -o layout -f {cmd_name}" if any(w in cmd_name for w in ("width", "split", "center", "column", "expel")) else f"qtile cmd-obj -o window -f {cmd_name}"
        elif cmd_name == "toscreen":
            grp_name = str(args[0]) if args else raw_key
            icon = "󰆍"
            cat = "Workspaces & Tags"
            desc = explicit_desc or f"Switch to Workspace {grp_name}"
            action = f"notify:Workspace:Switch to Workspace {grp_name}"
        elif cmd_name == "togroup":
            grp_name = str(args[0]) if args else raw_key
            icon = "󰆍"
            cat = "Workspaces & Tags"
            desc = explicit_desc or f"Move Focused Window to Workspace {grp_name} & Follow"
            action = f"notify:Workspace:Move Window to Workspace {grp_name}"
        elif cmd_name == "function":
            fn = args[0] if args else None
            fn_name = getattr(fn, "__name__", "")
            if fn_name in LAZY_DESCRIPTIONS:
                icon, cat, desc = LAZY_DESCRIPTIONS[fn_name]
            elif fn_name:
                desc = fn_name.replace("_", " ").title()
            action = f"notify:Function:{desc}"
        else:
            desc = desc or (f"Execute {cmd_name}" if cmd_name else "Shortcut Action")
            action = f"notify:Action:{desc}"

        dynamic_items.append({
            "category": cat,
            "icon": icon,
            "keys": combo,
            "description": desc,
            "action": action,
        })

    for g in GESTURES:
        dynamic_items.append(g)
    for m in MOUSE_ACTIONS:
        dynamic_items.append(m)

    return dynamic_items



# ==============================================================================
# 5. TAB REGISTRY & CONFIGURATION
# ==============================================================================
TABS = [
    ("qtile", "Qtile", "󰌌", "Qtile & Gestures", "Dynamic keyboard shortcuts, window controls & touchpad gestures"),
    ("config", "Config", "󰒓", "Environment Configs", "Catalog of 60+ config files, paths, statuses, and locations"),
    ("guide", "Guide", "󰈙", "Settings Guide", "Systems architecture, modular layouts, and settings guide"),
    ("kitty", "Kitty", "󰆍", "Kitty Terminal", "GPU-accelerated terminal emulator keybindings and kittens"),
    ("micro", "Micro", "󰅩", "Micro Editor", "Modern terminal text editor keybindings and multi-cursor"),
    ("helix", "Helix", "󰘦", "Helix Editor", "Modal text editor keybindings and Kakoune selection model"),
    ("yazi", "Yazi", "󰉋", "Yazi File Manager", "Asynchronous terminal file manager shortcuts and search"),
    ("nano", "Nano", "󰈙", "GNU Nano", "Standard terminal text editor keybindings and cutbuffer"),
]

TAB_LOOKUP = {t[0]: t for t in TABS}


def get_tab_header_lines(current_mode):
    """Generate quick tab-switcher header lines for inside menus."""
    lines = []
    # Compact tab bar overview
    tab_chips = []
    for mode_id, name, icon, _, _ in TABS:
        if mode_id == current_mode:
            tab_chips.append(f"[{icon} {name} (active)]")
        else:
            tab_chips.append(f"{icon} {name}")
    lines.append("󰌌  TAB BAR: " + "  │  ".join(tab_chips))

    # Actionable switchers to other tabs
    for mode_id, name, icon, label, desc in TABS:
        if mode_id != current_mode:
            lines.append(f"{icon}  [SWITCH TO TAB: {name}]  ──► {label} ({desc})")
    lines.append("────────────────────────────────────────────────────────────────────────────────────────")
    return lines


# ==============================================================================
# 6. FORMATTING HELPERS FOR ROFI
# ==============================================================================
def format_keybinding_lines(items, current_mode="qtile"):
    """Format shortcut items into aligned dmenu options."""
    lines = get_tab_header_lines(current_mode)
    if not items:
        lines.append("󰅖  No keybindings available in this catalog.")
        return lines

    max_key_len = max(len(item["keys"]) for item in items)
    for item in items:
        icon = item.get("icon", "󰌌")
        keys = item["keys"].ljust(max_key_len)
        desc = item["description"]
        cat = item["category"]
        lines.append(f"{icon}  {keys}  │  {desc}  [{cat}]")
    return lines


def format_config_lines(configs, current_mode="config"):
    """Format configuration files into aligned dmenu options."""
    lines = get_tab_header_lines(current_mode)
    max_name_len = min(32, max(len(c["name"]) for c in configs))
    max_cat_len = min(20, max(len(c["category"]) for c in configs))
    for c in configs:
        icon = c["icon"]
        cat = f"[{c['category']}]".ljust(max_cat_len + 2)
        name = c["name"].ljust(max_name_len)
        disp = c["display_path"]
        status = c["status"]
        size = c["size_formatted"]
        desc = c["description"]
        lines.append(f"{icon}  {cat}  {name}  │  {disp}  [{status} • {size}]  │  {desc}")
    return lines


def format_guide_lines(current_mode="guide"):
    """Format structured settings guide sections into aligned dmenu options."""
    lines = get_tab_header_lines(current_mode)
    sections = get_guide_sections()
    for s in sections:
        lines.append(f"{s['icon']}  {s['title']:<48}  │  {s['description']}")
    return lines


# ==============================================================================
# 7. ACTION DISPATCHERS & CLIPBOARD
# ==============================================================================
def copy_to_clipboard(text: str):
    """Copy text string to X11 clipboard via xclip or xsel."""
    if not os.environ.get("DISPLAY"):
        return
    try:
        if shutil.which("xclip"):
            proc = subprocess.Popen(["xclip", "-selection", "clipboard"], stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            try:
                proc.communicate(input=text.encode("utf-8"), timeout=0.5)
            except (subprocess.TimeoutExpired, Exception):
                proc.kill()
        elif shutil.which("xsel"):
            proc = subprocess.Popen(["xsel", "--clipboard", "--input"], stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            try:
                proc.communicate(input=text.encode("utf-8"), timeout=0.5)
            except (subprocess.TimeoutExpired, Exception):
                proc.kill()
    except Exception:
        pass


def notify_user(title: str, body: str, urgency: str = "low"):
    """Send desktop notification via dunstify or notify-send."""
    if not os.environ.get("DISPLAY"):
        return
    try:
        if shutil.which("dunstify"):
            subprocess.run(["dunstify", "-a", "Cheatsheet", "-u", urgency, title, body], timeout=1.0, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif shutil.which("notify-send"):
            subprocess.run(["notify-send", "-a", "Cheatsheet", "-u", urgency, title, body], timeout=1.0, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def open_config_path(config_item):
    """Open the selected configuration file in terminal editor or file manager."""
    target_path = Path(config_item["target_path"])
    display_path = config_item["display_path"]

    if not config_item["exists"]:
        notify_user("File Not Found", f"{display_path} does not exist yet.", urgency="normal")
        return

    term = os.environ.get("QTILE_TERMINAL", "alacritty")
    term_bin = shutil.which(term) or shutil.which("alacritty") or "/usr/bin/alacritty"

    if config_item["is_dir"]:
        if shutil.which("xdg-open"):
            subprocess.Popen(["xdg-open", str(target_path)], start_new_session=True)
        else:
            subprocess.Popen([term_bin, "--working-directory", str(target_path)], start_new_session=True)
    else:
        editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or "micro"
        editor_bin = shutil.which(editor) or shutil.which("micro") or shutil.which("nano") or "/usr/bin/micro"
        subprocess.Popen([term_bin, "-e", editor_bin, str(target_path)], start_new_session=True)

    notify_user("Opened Configuration", f"{config_item['name']}\n{display_path}")


def open_guide():
    """Open SETTINGS_GUIDE.md in user's terminal text editor."""
    config_dir = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "qtile"
    guide_file = config_dir / "SETTINGS_GUIDE.md"
    if not guide_file.is_file():
        guide_file = Path(__file__).resolve().parent.parent / "docs" / "SETTINGS_GUIDE.md"

    term = os.environ.get("QTILE_TERMINAL", "alacritty")
    term_bin = shutil.which(term) or shutil.which("alacritty") or "/usr/bin/alacritty"
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or "micro"
    editor_bin = shutil.which(editor) or shutil.which("micro") or shutil.which("nano") or "/usr/bin/micro"
    subprocess.Popen([term_bin, "-e", editor_bin, str(guide_file)], start_new_session=True)


def execute_action(action: str, keys: str = "", desc: str = "", app_name: str = "Qtile"):
    """Execute shortcut action, copy keys to clipboard, or send notification."""
    if not action:
        if keys:
            copy_to_clipboard(keys)
            notify_user(f"{app_name} Shortcut Copied", f"{keys}\n{desc}")
        return

    if action.startswith("notify:"):
        parts = action[len("notify:"):].split(":", 1)
        title = parts[0].strip() if len(parts) > 1 else f"{app_name} Reference"
        body = parts[1].strip() if len(parts) > 1 else parts[0].strip()
        if keys:
            copy_to_clipboard(keys)
            body = f"{body}\n({keys} copied to clipboard)"
        notify_user(title, body)
        return

    # If keys provided and not starting with qtile cmd, copy to clipboard as convenience
    if keys:
        copy_to_clipboard(keys)

    # Execute system command or script
    try:
        subprocess.Popen(action, shell=True, start_new_session=True)
    except Exception as e:
        sys.stderr.write(f"Failed to execute action {action}: {e}\n")


# ==============================================================================
# 8. TABBED LAUNCHER CONTROLLER (ROFI NATIVE MODI & DMENU FALLBACK)
# ==============================================================================
def get_items_for_mode(mode: str):
    """Retrieve catalog list corresponding to the requested tab/mode."""
    mode = mode.lower()
    if mode in ("qtile", "keys", "shortcuts", "gestures"):
        return get_qtile_keybindings()
    elif mode in ("config", "configs", "locations"):
        return get_environment_configs()
    elif mode in ("guide", "settings"):
        return get_guide_sections()
    elif mode == "kitty":
        return KITTY_SHORTCUTS
    elif mode == "micro":
        return MICRO_SHORTCUTS
    elif mode == "helix" or mode == "hx":
        return HELIX_SHORTCUTS
    elif mode == "yazi":
        return YAZI_SHORTCUTS
    elif mode == "nano":
        return NANO_SHORTCUTS
    return get_qtile_keybindings()


def print_mode_entries(mode: str):
    """Emit Rofi script mode prompt, metadata, and rows for the given tab."""
    prompt = TAB_LOOKUP.get(mode, ("", "", "", mode.title()))[3]
    print(f"\0prompt\x1f{prompt}")
    print(f"\0data\x1f{mode}")

    if mode in ("config", "configs"):
        configs = get_environment_configs()
        for line in format_config_lines(configs, current_mode="config"):
            print(line)
    elif mode in ("guide", "settings"):
        for line in format_guide_lines(current_mode="guide"):
            print(line)
    else:
        items = get_items_for_mode(mode)
        for line in format_keybinding_lines(items, current_mode=mode):
            print(line)


def handle_selection(mode: str, selected: str):
    """Handle user item selection across all modes."""
    selected = (selected or "").strip()
    if not selected or selected.startswith("󰅖") or "TAB BAR:" in selected or "───────" in selected:
        return

    # Check for tab switcher request (used when invoked via dmenu fallback)
    m = re.search(r"\[SWITCH TO TAB:\s*([^\]]+)\]", selected, re.IGNORECASE)
    if m:
        target_name = m.group(1).strip().lower()
        target_mode = "qtile"
        for t_id, t_name, _, _, _ in TABS:
            if target_name in t_id.lower() or target_name in t_name.lower():
                target_mode = t_id
                break
        show_dmenu_menu(mode=target_mode)
        return

    if mode in ("config", "configs"):
        configs = get_environment_configs()
        for c in configs:
            if c["name"] in selected and c["display_path"] in selected:
                open_config_path(c)
                return
        for c in configs:
            if c["display_path"] in selected or c["name"] in selected:
                open_config_path(c)
                return
        return

    if mode in ("guide", "settings"):
        open_guide()
        return

    # Matching in shortcut catalogs
    items = get_items_for_mode(mode)
    app_label = TAB_LOOKUP.get(mode, ("", "Cheatsheet"))[1]

    for item in items:
        if item["keys"] in selected and item["category"] in selected:
            execute_action(item.get("action", ""), keys=item["keys"], desc=item["description"], app_name=app_label)
            return

    for item in items:
        if item["keys"] in selected:
            execute_action(item.get("action", ""), keys=item["keys"], desc=item["description"], app_name=app_label)
            return

    # Fallback search across all tool catalogs if not matched in active mode
    for t_id, t_name, _, _, _ in TABS:
        if t_id not in ("config", "guide"):
            for item in get_items_for_mode(t_id):
                if item["keys"] in selected:
                    execute_action(item.get("action", ""), keys=item["keys"], desc=item["description"], app_name=t_name)
                    return


def rofi_modi_entrypoint(mode: str, selection: str = None):
    """Entrypoint called by Rofi when running in custom script mode."""
    retv = os.environ.get("ROFI_RETV", "0")
    active_mode = os.environ.get("ROFI_DATA") or mode

    sel = selection if selection is not None else (sys.argv[3] if len(sys.argv) > 3 else None)

    # If called with selection (user clicked or pressed Enter)
    if retv == "1" or sel:
        sel_str = (sel or "").strip()

        # 1. Did the user select a tab switcher?
        m = re.search(r"\[SWITCH TO TAB:\s*([^\]]+)\]", sel_str, re.IGNORECASE)
        if m:
            target_name = m.group(1).strip().lower()
            target_mode = "qtile"
            for t_id, t_name, _, _, _ in TABS:
                if target_name in t_id.lower() or target_name in t_name.lower():
                    target_mode = t_id
                    break
            # Emit new tab entries on stdout so Rofi updates in-place and stays open!
            print_mode_entries(target_mode)
            sys.exit(0)

        # 2. Did the user click on a non-actionable header or separator?
        if not sel_str or "TAB BAR:" in sel_str or "───────" in sel_str or sel_str.startswith("󰅖"):
            print_mode_entries(active_mode)
            sys.exit(0)

        # 3. Actionable selection: perform action and exit with no output (closes Rofi)
        handle_selection(active_mode, sel_str)
        sys.exit(0)

    # Initial list generation (no selection)
    print_mode_entries(active_mode)


def launch_tabbed_rofi(initial_mode: str = "qtile"):
    """Launch Rofi with 8 native sidebar tab buttons using custom script modes."""
    theme = get_theme_path()
    self_path = str(Path(__file__).resolve())

    # Ensure initial mode is valid
    if initial_mode not in TAB_LOOKUP:
        # Match by prefix/alias
        for t_id in TAB_LOOKUP:
            if initial_mode.lower() in t_id:
                initial_mode = t_id
                break
        else:
            initial_mode = "qtile"

    initial_tab_name = TAB_LOOKUP[initial_mode][1]

    modes_arg = ",".join(f"{label}:{self_path} --rofi-modi {m_id}" for m_id, label, _, _, _ in TABS)

    rofi_cmd = [
        "rofi",
        "-show", initial_tab_name,
        "-modes", modes_arg,
        "-sidebar-mode",
        "-theme", theme,
        "-theme-str", "window { width: 75%; } listview { lines: 15; }",
    ]

    try:
        proc = subprocess.run(rofi_cmd)
        if proc.returncode != 0 and proc.returncode != 1:
            # Fallback to dmenu if script modes failed
            show_dmenu_menu(mode=initial_mode)
    except Exception as e:
        sys.stderr.write(f"Rofi tabbed modes error: {e}. Falling back to dmenu...\n")
        show_dmenu_menu(mode=initial_mode)


def show_dmenu_menu(mode: str = "qtile"):
    """Fallback interactive dmenu runner with tab switcher headers."""
    theme = get_theme_path()

    if mode in ("config", "configs"):
        configs = get_environment_configs()
        lines = format_config_lines(configs, current_mode="config")
        prompt = "Config Locations > "
    elif mode in ("guide", "settings"):
        lines = format_guide_lines(current_mode="guide")
        prompt = "Settings Guide > "
    else:
        items = get_items_for_mode(mode)
        prompt = f"{TAB_LOOKUP.get(mode, ('', mode.title()))[1]} Keys > "
        lines = format_keybinding_lines(items, current_mode=mode)

    rofi_cmd = [
        "rofi", "-dmenu", "-i",
        "-p", prompt,
        "-theme", theme,
        "-theme-str", "window { width: 75%; } listview { lines: 15; }",
    ]

    try:
        proc = subprocess.Popen(
            rofi_cmd,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
        selected, _ = proc.communicate(input="\n".join(lines))
        handle_selection(mode, (selected or "").strip())
    except Exception as e:
        sys.stderr.write(f"Error launching Rofi dmenu: {e}\n")


# ==============================================================================
# 9. MARKDOWN DOCUMENTATION GENERATOR
# ==============================================================================
def generate_markdown():
    """Generate comprehensive Markdown documentation covering all 8 tabs."""
    md = [
        "# Qtile-Con Keyboard Shortcuts & Gestures Cheatsheet",
        "",
        "## Unified Tabbed Developer Tools & Keybindings Reference Palette",
        "",
        "Quickly access this interactive tabbed reference palette anywhere on your desktop by pressing:",
        "",
        "> `Super + /`  or  `Super + ?`  or  `Super + s`",
        "",
        "To jump directly to any specific tool tab:",
        "",
        "- **Qtile & Gestures:** `Super + /` or `keybindings-cheatsheet qtile`",
        "- **Config Locations:** `Super + Ctrl + /` or `keybindings-cheatsheet config`",
        "- **Settings Guide:** `keybindings-cheatsheet guide`",
        "- **Kitty Terminal:** `keybindings-cheatsheet kitty`",
        "- **Micro Editor:** `keybindings-cheatsheet micro`",
        "- **Helix Modal Editor:** `keybindings-cheatsheet helix`",
        "- **Yazi File Manager:** `keybindings-cheatsheet yazi`",
        "- **GNU Nano Editor:** `keybindings-cheatsheet nano`",
        "",
        "---",
        "",
    ]

    # Tab 1: Qtile & Gestures
    md.append("# 1. Qtile Window Manager & Gestures")
    md.append("")
    qtile_items = get_qtile_keybindings()
    cats = {}
    for item in qtile_items:
        c = item["category"]
        cats.setdefault(c, []).append(item)

    for cat_name, items in cats.items():
        md.append(f"## {cat_name}")
        md.append("")
        md.append("| Key / Gesture | Description | Action |")
        md.append("| :--- | :--- | :--- |")
        home_str = str(Path.home())
        for it in items:
            raw_act = it['action']
            clean_act = raw_act.replace(home_str, "~")
            act = f"`{clean_act}`" if not raw_act.startswith("notify:") else "Desktop Notification"
            md.append(f"| `{it['keys']}` | {it['description']} | {act} |")
        md.append("")

    # Developer Tools
    tool_catalogs = [
        ("2. Kitty Terminal Emulator", KITTY_SHORTCUTS),
        ("3. Micro Terminal Text Editor", MICRO_SHORTCUTS),
        ("4. Helix Modern Modal Editor", HELIX_SHORTCUTS),
        ("5. Yazi Asynchronous File Manager", YAZI_SHORTCUTS),
        ("6. GNU Nano Terminal Editor", NANO_SHORTCUTS),
    ]

    for tool_title, tool_items in tool_catalogs:
        md.append("---")
        md.append("")
        md.append(f"# {tool_title}")
        md.append("")
        t_cats = {}
        for it in tool_items:
            t_cats.setdefault(it["category"], []).append(it)
        for cat_name, items in t_cats.items():
            md.append(f"## {cat_name}")
            md.append("")
            md.append("| Key Combination | Description |")
            md.append("| :--- | :--- |")
            for it in items:
                md.append(f"| `{it['keys']}` | {it['description']} |")
            md.append("")

    # Config Locations
    md.append("---")
    md.append("")
    md.append("# 7. Environment Configuration Locations Catalog")
    md.append("")
    configs = get_environment_configs()
    cfg_cats = {}
    for c in configs:
        cfg_cats.setdefault(c["category"], []).append(c)

    for cat_name, items in cfg_cats.items():
        md.append(f"## {cat_name}")
        md.append("")
        md.append("| File / Target | Active Location | Source / Fallback | Status | Size | Purpose & Description |")
        md.append("| :--- | :--- | :--- | :--- | :--- | :--- |")
        for c in items:
            md.append(f"| `{c['name']}` | `{c['display_path']}` | `{c['source_display']}` | {c['status']} | {c['size_formatted']} | {c['description']} |")
        md.append("")

    return "\n".join(md)


# ==============================================================================
# 10. CLI ARGUMENTS & DISPATCHER
# ==============================================================================
def main():
    # Check for internal Rofi script mode invocation
    if len(sys.argv) > 1 and sys.argv[1] == "--rofi-modi":
        mode = sys.argv[2] if len(sys.argv) > 2 else "qtile"
        selection = sys.argv[3] if len(sys.argv) > 3 else None
        rofi_modi_entrypoint(mode, selection)
        return

    if len(sys.argv) > 1:
        arg = sys.argv[1].lower()

        # Non-interactive JSON exports
        if arg in ("--json", "-j"):
            submode = sys.argv[2].lower() if len(sys.argv) > 2 else "qtile"
            if submode in ("all", "--all"):
                payload = {
                    "qtile": get_qtile_keybindings(),
                    "config": get_environment_configs(),
                    "guide": get_guide_sections(),
                    "kitty": KITTY_SHORTCUTS,
                    "micro": MICRO_SHORTCUTS,
                    "helix": HELIX_SHORTCUTS,
                    "yazi": YAZI_SHORTCUTS,
                    "nano": NANO_SHORTCUTS,
                }
                print(json.dumps(payload, indent=2))
            else:
                items = get_items_for_mode(submode)
                print(json.dumps(items, indent=2))
            return

        elif arg in ("--json-configs", "--json=configs", "-jc"):
            print(json.dumps(get_environment_configs(), indent=2))
            return

        elif arg in ("--json-all", "--json=all"):
            payload = {
                "keybindings": get_qtile_keybindings(),
                "config_locations": get_environment_configs(),
                "kitty": KITTY_SHORTCUTS,
                "micro": MICRO_SHORTCUTS,
                "helix": HELIX_SHORTCUTS,
                "yazi": YAZI_SHORTCUTS,
                "nano": NANO_SHORTCUTS,
            }
            print(json.dumps(payload, indent=2))
            return

        elif arg in ("--markdown", "-md", "--doc"):
            print(generate_markdown())
            return

        elif arg.startswith("--dmenu"):
            mode = sys.argv[2].lower() if len(sys.argv) > 2 else "qtile"
            show_dmenu_menu(mode=mode)
            return

        elif arg in ("--help", "-h"):
            print("Usage: keybindings-cheatsheet [TAB] [OPTIONS]")
            print("\nInteractive Tabbed Modes:")
            print("  keybindings-cheatsheet             Open tabbed launcher (Qtile & Gestures tab default)")
            print("  keybindings-cheatsheet qtile       Open directly to Qtile Keybindings & Gestures")
            print("  keybindings-cheatsheet config      Open directly to Environment Configuration Files")
            print("  keybindings-cheatsheet guide       Open directly to Systems Architecture & Settings Guide")
            print("  keybindings-cheatsheet kitty       Open directly to Kitty Terminal Keybindings")
            print("  keybindings-cheatsheet micro       Open directly to Micro Text Editor Keybindings")
            print("  keybindings-cheatsheet helix       Open directly to Helix Modal Editor Keybindings")
            print("  keybindings-cheatsheet yazi        Open directly to Yazi Terminal File Manager Keybindings")
            print("  keybindings-cheatsheet nano        Open directly to GNU Nano Editor Keybindings")
            print("\nNon-Interactive Export Flags:")
            print("  --json [tab|all]                   Export keybindings catalog as JSON (default: qtile)")
            print("  --json-configs                     Export environment config locations catalog as JSON")
            print("  --json-all                         Export all tabs and catalogs as unified JSON")
            print("  --markdown                         Generate full Markdown documentation for all 8 tabs")
            print("  --dmenu [tab]                      Run using standalone dmenu instead of tabbed modes")
            print("  --help, -h                         Show this help message")
            return

        # Direct tab launch
        matched_mode = None
        for t_id in TAB_LOOKUP:
            if arg in (t_id, f"--{t_id}", f"--tab={t_id}"):
                matched_mode = t_id
                break
        if not matched_mode:
            # Check aliases
            if arg in ("shortcuts", "keys", "gestures"):
                matched_mode = "qtile"
            elif arg in ("configs", "locations"):
                matched_mode = "config"
            elif arg in ("settings",):
                matched_mode = "guide"
            elif arg in ("hx",):
                matched_mode = "helix"

        if matched_mode:
            launch_tabbed_rofi(initial_mode=matched_mode)
            return

    # Default invocation
    launch_tabbed_rofi(initial_mode="qtile")


if __name__ == "__main__":
    main()

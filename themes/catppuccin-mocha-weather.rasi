/* Dynamic Qtile-Con Weather Card Grid Theme — catppuccin-mocha */
configuration {
    show-icons: false;
}

* {
    font: "JetBrainsMono Nerd Font 9.5";
    background-color: transparent;
    text-color: #cdd6f4;
}

window {
    location: center;
    anchor: center;
    width: 72%;
    border: 2px;
    border-color: #89b4fa;
    border-radius: 12px;
    background-color: #1e1e2e;
    padding: 14px;
}

mainbox {
    background-color: #1e1e2e;
    spacing: 12px;
    children: [ inputbar, message, listview ];
}

inputbar {
    background-color: #313244;
    border: 1px;
    border-color: #45475a;
    border-radius: 8px;
    padding: 8px 14px;
    children: [ prompt, entry ];
    spacing: 8px;
}

prompt {
    text-color: #89b4fa;
    font: "JetBrainsMono Nerd Font Bold 10";
}

entry {
    placeholder: "Filter forecast…";
    placeholder-color: #6c7086;
    text-color: #cdd6f4;
}

message {
    background-color: #313244;
    border: 1px;
    border-color: #89b4fa;
    border-radius: 8px;
    padding: 10px 14px;
}

textbox {
    text-color: #89b4fa;
    font: "JetBrainsMono Nerd Font Bold 10";
}

listview {
    background-color: #1e1e2e;
    lines: 6;
    columns: 2;
    fixed-height: false;
    fixed-columns: true;
    spacing: 10px;
    scrollbar: false;
    cycle: true;
}

element {
    background-color: #313244;
    border-radius: 8px;
    padding: 10px 14px;
    orientation: horizontal;
    spacing: 8px;
    border: 1px;
    border-color: #45475a;
}

element selected {
    background-color: #45475a;
    text-color: #89b4fa;
    border: 1px;
    border-color: #cba6f7;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    horizontal-align: 0.0;
    vertical-align: 0.5;
}
